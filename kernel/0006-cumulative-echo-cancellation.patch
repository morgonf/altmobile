+err:
+	dma_free_coherent(mvm->dev, mem->alloc_size, mem->alloc, mem->alloc_phys);
+	memset(mem, 0, sizeof(*mem));
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6mvm_mem_map);
