+enum q6voice_cal_mode {
+	Q6VOICE_CAL_SEND,
+	Q6VOICE_CAL_CHECK,
+	/* Выключить модули, которые калибровка включает (0x10e00 не ноль) */
+	Q6VOICE_CAL_DISABLE,
+};
