+static void q6cvp_fill_mapping(u8 *map, unsigned int channels, bool is_tx)
+{
+	memset(map, 0, VSS_NUM_CHANNELS_MAX);
+
+	if (ds_mapping) {
+		if (channels == 1) {
+			map[0] = PCM_CHANNEL_FC;
+		} else {
+			map[0] = PCM_CHANNEL_FL;
+			map[1] = PCM_CHANNEL_FR;
+		}
+		return;
+	}
