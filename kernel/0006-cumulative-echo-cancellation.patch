+int q6mvm_mem_unmap(struct q6voice_session *mvm, struct q6voice_mem *mem)
+{
+	struct vss_imemory_cmd_unmap cmd;
+	int ret = 0;
+
+	if (!mem->alloc)
+		return 0;
+
+	if (mem->handle) {
+		cmd.hdr.pkt_size = sizeof(cmd);
+		cmd.hdr.opcode = VSS_IMEMORY_CMD_UNMAP;
+		cmd.mem_handle = mem->handle;
