+struct q6voice_cal_header {
+	u8 magic[8];
+	__le32 version;
+	__le32 tx_device;
+	__le32 rx_device;
+	__le32 tx_rate;
+	__le32 rx_rate;
+	__le32 count;
+	__le32 data_size;
