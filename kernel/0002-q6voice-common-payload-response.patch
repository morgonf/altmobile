+static void q6voice_session_payload_rsp(struct q6voice_session *s,
+					const struct apr_resp_pkt *data)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&s->lock, flags);
+	if (data->hdr.opcode != s->expected_rsp_opcode) {
+		spin_unlock_irqrestore(&s->lock, flags);
+		return; /* Not handled here */
+	}
+
+	if (s->handle != data->hdr.src_port) {
+		spin_unlock_irqrestore(&s->lock, flags);
+		dev_warn(s->dev, "unexpected reply for session %#x (!= %#x)\n",
+			 data->hdr.src_port, s->handle);
+		return;
+	}
+
+	if (data->payload_size < s->rsp_size) {
+		spin_unlock_irqrestore(&s->lock, flags);
+		dev_err(s->dev, "response %#x too short: %d < %zu\n",
+			data->hdr.opcode, data->payload_size, s->rsp_size);
+		return;
+	}
+
+	if (s->rsp_size)
+		memcpy(s->rsp, data->payload, s->rsp_size);
+
+	s->result = 0;
+	s->expected_opcode = 0;
+	s->expected_rsp_opcode = 0;
+	spin_unlock_irqrestore(&s->lock, flags);
+
+	wake_up(&s->wait);
+}
