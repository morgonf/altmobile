--- a/drivers/nfc/nxp-nci/core.c
+++ b/drivers/nfc/nxp-nci/core.c
@@ -190,10 +190,16 @@
 	if (info->phy_ops->set_mode)
 		info->phy_ops->set_mode(info->phy_id, NXP_NCI_MODE_COLD);
 
+	mutex_unlock(&info->info_lock);
+
+	/*
+	 * Not under info_lock: nci_unregister_device() closes an open device
+	 * through nxp_nci_close(), which takes info_lock itself. Holding it
+	 * here deadlocked every unbind of a powered adapter (OnePlus 6T,
+	 * PN553), with the IRQ thread stuck on the same mutex.
+	 */
 	nci_unregister_device(ndev);
 	nci_free_device(ndev);
-
-	mutex_unlock(&info->info_lock);
 }
 EXPORT_SYMBOL(nxp_nci_remove);
 
--- a/drivers/nfc/nxp-nci/i2c.c
+++ b/drivers/nfc/nxp-nci/i2c.c
@@ -317,8 +317,12 @@
 {
 	struct nxp_nci_i2c_phy *phy = i2c_get_clientdata(client);
 
-	nxp_nci_remove(phy->ndev);
+	/*
+	 * Free the IRQ first: the threaded handler uses phy->ndev, which
+	 * nxp_nci_remove() frees.
+	 */
 	free_irq(client->irq, phy);
+	nxp_nci_remove(phy->ndev);
 }
 
