 private:
 	void updateFocus(IPAContext &context, IPAFrameContext &frameContext, double focus);
-        void step(IPAContext &context, double& focus_pos, uint64_t sharp, bool& sweep);
+	void step(IPAContext &context, double& focus_pos, uint64_t sharp, bool& sweep);
 	void restart(IPAContext &context);
 };
 
diff --git a/src/ipa/simple/algorithms/agc.cpp b/src/ipa/simple/algorithms/agc.cpp
index a5331d9..5b50ff1 100644
--- a/src/ipa/simple/algorithms/agc.cpp
+++ b/src/ipa/simple/algorithms/agc.cpp
@@ -53,13 +53,17 @@ static constexpr float kExposureSatisfactory = 0.2;
  * This replaces the fixed 10% bang-bang step with a proportional correction
  * that converges smoothly and avoids overshooting near the target.
  */
-static constexpr float kExpProportionalGain = 0.04;
+/*
+ * ALT Mobile: 0.15 instead of 0.04. With statistics every second frame and
+ * the software ISP at 11-22 fps, 0.04 took 5-7 s to leave a dark scene.
+ */
+static constexpr float kExpProportionalGain = 0.15;
 
 /*
  * Maximum multiplicative step per frame, to bound the correction when the
  * scene changes dramatically.
  */
-static constexpr float kExpMaxStep = 0.15;
+static constexpr float kExpMaxStep = 0.35;
 
 Agc::Agc()
 {
diff --git a/src/ipa/simple/ipa_context.h b/src/ipa/simple/ipa_context.h
index f58af7c..2172bff 100644
--- a/src/ipa/simple/ipa_context.h
+++ b/src/ipa/simple/ipa_context.h
@@ -39,6 +39,10 @@ struct IPASessionConfiguration {
 		uint64_t sharpness_max;
 		double start, stop, step;
 		uint32_t skip;
+		/* 0: coarse pass, 1: fine pass */
+		unsigned int phase;
+		/* consecutive statistics that disagree with the focused sharpness */
+		unsigned int lost;
 	} focus;
 };
 
