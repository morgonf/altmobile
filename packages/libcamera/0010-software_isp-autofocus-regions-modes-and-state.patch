-void Af::queueRequest([[maybe_unused]] typename Module::Context &context,
+/* Grid cells covered by rectangles given in pixel array coordinates */
+uint32_t Af::windowsToMask(const IPAContext &context, Span<const Rectangle> windows) const
+{
+	const Rectangle &crop = context.sensorInfo.analogCrop;
+	uint32_t mask = 0;
+
+	if (crop.width == 0 || crop.height == 0)
+		return kCentreMask;
+
+	for (const Rectangle &r : windows) {
+		auto cell = [](int64_t v, int64_t origin, uint64_t size) {
+			return static_cast<int>(std::clamp<int64_t>((v - origin) * kGrid / static_cast<int64_t>(size),
+								    0, kGrid - 1));
+		};
+		const int x0 = cell(r.x, crop.x, crop.width);
+		const int x1 = cell(r.x + r.width - 1, crop.x, crop.width);
+		const int y0 = cell(r.y, crop.y, crop.height);
+		const int y1 = cell(r.y + r.height - 1, crop.y, crop.height);
+		for (int y = y0; y <= y1; y++)
+			for (int x = x0; x <= x1; x++)
+				mask |= 1u << (y * kGrid + x);
+	}
+
+	return mask ? mask : kCentreMask;
+}
