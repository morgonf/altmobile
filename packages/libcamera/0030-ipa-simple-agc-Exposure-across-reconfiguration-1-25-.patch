From 7f6dd6993464e1a03dc283c5e93e31e01522c13d Mon Sep 17 00:00:00 2001
From: morgonf <morgonf@altlinux.org>
Date: Sat, 3 Oct 2026 14:12:10 -0400
Subject: [PATCH 30/30] ipa: simple: agc: Exposure across reconfiguration, 1/25
 s time priority

Three changes for photos at full size, found on the IMX519 of the OnePlus
6T, whose line is 1.83 times longer at full size than in the binned
viewfinder mode.

The sensor keeps the exposure in lines over a reconfiguration, so every
full size photo was 0.9 EV brighter than the viewfinder, and AE had only
three statistics to correct it. The exposure is now carried over as a
time (times gain) into the lines of the new mode, also with AE locked,
and two statistics from frames before the change are skipped.

The exposure time took the light first up to the frame length, 87 ms at
full size: hand-held photos were shaken. The time now goes first only up
to 1/25 s, then the gain, and longer only with the gain at its maximum.

Spot metering on a tapped dark object blew out the rest of the photo
(62 % of the pixels in the top bin). It now moves the exposure by at
most one stop from the frame metering, and does not brighten a frame
with more than a quarter of its pixels in the top bin.
---
 src/ipa/simple/algorithms/agc.cpp | 117 +++++++++++++++++++++++++++---
 src/ipa/simple/algorithms/agc.h   |  14 ++++
 2 files changed, 120 insertions(+), 11 deletions(-)

diff --git a/src/ipa/simple/algorithms/agc.cpp b/src/ipa/simple/algorithms/agc.cpp
index 94721bbe2..94930b838 100644
--- a/src/ipa/simple/algorithms/agc.cpp
+++ b/src/ipa/simple/algorithms/agc.cpp
@@ -82,6 +82,29 @@ static constexpr float kExpOverStep = 0.6;
  */
 static constexpr utils::Duration kDefaultMaxFrameDuration = 66667us;
 
+/*
+ * Statistics skipped after the exposure was carried over a reconfiguration:
+ * they come from frames the sensor took before it applied the new values.
+ */
+static constexpr unsigned int kCarrySkipStats = 2;
+
+/*
+ * The exposure time takes the light first only up to 1/25 s, then the gain
+ * does, and the time grows further only with the gain at its maximum. The
+ * full size mode of the IMX519 has 88 ms frames, and an exposure as long
+ * as the frame shook every photo taken by hand.
+ */
+static constexpr utils::Duration kTimeFirstMax = 40000us;
+
+/*
+ * Spot metering on a tapped region moves the exposure by at most this
+ * factor either way from the frame metering, and never brightens a frame
+ * with more than kSpotHighlights of its pixels in the top histogram bin.
+ * Metering a dark object alone blew out the rest of the photo.
+ */
+static constexpr float kSpotMaxRatio = 2.0f;
+static constexpr float kSpotHighlights = 0.25f;
+
 Agc::Agc()
 {
 }
@@ -119,6 +142,8 @@ int Agc::configure(IPAContext &context,
 	context.activeState.knobs.ae_enabled = std::optional<bool>();
 	context.activeState.agc.maxFrameDuration = kDefaultMaxFrameDuration;
 	context.activeState.agc.vblank = context.configuration.agc.vblankDef;
+	carryPending_ = lastExposureTime_ > utils::Duration(0) && lastGain_ > 0.0;
+	carrySkip_ = 0;
 
 	auto &agc = context.configuration.agc;
 	if (lineDurationScale_ > 0.0)
@@ -162,6 +187,56 @@ void Agc::queueRequest(typename Module::Context &context,
 	}
 }
 
+/* Longest exposure in lines: up to maxFrameDuration and what VBLANK allows */
+int32_t Agc::longExposureMax(const IPAContext &context) const
+{
+	const auto &agc = context.configuration.agc;
+	if (!agc.hasVblank || agc.lineDuration <= utils::Duration(0))
+		return agc.exposureMax;
+
+	const auto lines = static_cast<int64_t>(context.activeState.agc.maxFrameDuration / agc.lineDuration);
+	return static_cast<int32_t>(std::clamp<int64_t>(lines, agc.exposureMax,
+							static_cast<int64_t>(agc.exposureMax) + agc.vblankMax - agc.vblankDef));
+}
+
+/* Exposure in lines up to which the time takes the light before the gain */
+int32_t Agc::timeFirstMax(const IPAContext &context) const
+{
+	const auto &agc = context.configuration.agc;
+	if (agc.lineDuration <= utils::Duration(0))
+		return agc.exposureMax;
+
+	const auto lines = static_cast<int32_t>(kTimeFirstMax / agc.lineDuration);
+	return std::clamp(lines, agc.exposureMin, agc.exposureMax);
+}
+
+/* First frame after a reconfiguration: the last exposure time in new lines */
+void Agc::carryOver(IPAContext &context, IPAFrameContext &frameContext)
+{
+	const auto &agc = context.configuration.agc;
+	const double total = lastExposureTime_ / agc.lineDuration * lastGain_;
+	int32_t exposure = std::clamp(static_cast<int32_t>(total / agc.againMin),
+				      agc.exposureMin, timeFirstMax(context));
+	if (total / exposure > agc.againMax)
+		exposure = std::clamp(static_cast<int32_t>(total / agc.againMax),
+				      exposure, longExposureMax(context));
+	const double again = std::clamp(total / exposure, agc.againMin, agc.againMax);
+	const int32_t vblank = agc.hasVblank
+		? agc.vblankDef + std::max(0, exposure - agc.exposureMax) : 0;
+
+	frameContext.sensor.exposure = exposure;
+	frameContext.sensor.gain = again;
+	frameContext.sensor.vblank = vblank;
+	context.activeState.agc.exposure = exposure;
+	context.activeState.agc.again = again;
+	context.activeState.agc.vblank = vblank;
+	context.activeState.agc.valid = true;
+
+	LOG(IPASoftExposure, Debug)
+		<< "Carried " << lastExposureTime_ << " x " << lastGain_
+		<< " over: exp " << exposure << " again " << again << " vblank " << vblank;
+}
+
 void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext, double exposureMSV)
 {
 	int32_t &exposure = frameContext.sensor.exposure;
@@ -189,17 +264,18 @@ void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext, dou
 
 	/*
 	 * ALT Mobile: scale the total exposure (time x gain) and give it to the
-	 * exposure time first, up to its maximum, and only the rest to the
+	 * exposure time first, up to kTimeFirstMax, and only the rest to the
 	 * analogue gain. Raising only the time left a high gain from an earlier
 	 * scene in place, and the picture stayed noisy.
 	 */
 	const auto &agc = context.configuration.agc;
 	const double total = std::max(static_cast<double>(exposure) * again * factor,
 				      static_cast<double>(agc.exposureMin) * agc.againMin);
+	const int32_t timeMax = timeFirstMax(context);
 	int32_t nextExposure = static_cast<int32_t>(total / agc.againMin);
-	nextExposure = std::clamp(nextExposure, agc.exposureMin, agc.exposureMax);
+	nextExposure = std::clamp(nextExposure, agc.exposureMin, timeMax);
 	/* Keep moving by at least one line when the exposure time decides */
-	if (factor > 1.0f && nextExposure == exposure && exposure < agc.exposureMax)
+	if (factor > 1.0f && nextExposure == exposure && exposure < timeMax)
 		nextExposure = exposure + 1;
 	else if (factor < 1.0f && nextExposure == exposure && exposure > agc.exposureMin)
 		nextExposure = exposure - 1;
@@ -210,12 +286,7 @@ void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext, dou
 	 * Gain at its maximum and still too dark: lengthen the frame, up to
 	 * maxFrameDuration and to what VBLANK allows.
 	 */
-	int32_t longMax = agc.exposureMax;
-	if (agc.hasVblank && agc.lineDuration > utils::Duration(0)) {
-		const auto lines = static_cast<int64_t>(context.activeState.agc.maxFrameDuration / agc.lineDuration);
-		longMax = static_cast<int32_t>(std::clamp<int64_t>(lines, agc.exposureMax,
-								   static_cast<int64_t>(agc.exposureMax) + agc.vblankMax - agc.vblankDef));
-	}
+	const int32_t longMax = longExposureMax(context);
 	if (again > agc.againMax && longMax > exposure) {
 		exposure = std::clamp(static_cast<int32_t>(total / agc.againMax), exposure, longMax);
 		again = total / exposure;
@@ -253,6 +324,17 @@ void Agc::process(IPAContext &context,
 	metadata.set(controls::ExposureTime, exposureTime.get<std::micro>());
 	metadata.set(controls::AnalogueGain, frameContext.sensor.gain);
 	LOG(IPASoftExposure, Debug) << "Setting exposure value to " << frameContext.sensor.exposure;
+
+	/* Also with AE locked: the lock keeps the brightness, not the lines */
+	if (carryPending_) {
+		carryPending_ = false;
+		carrySkip_ = kCarrySkipStats;
+		carryOver(context, frameContext);
+		return;
+	}
+	lastExposureTime_ = exposureTime;
+	lastGain_ = frameContext.sensor.gain;
+
 	if (!ae_enable)
 		return;
 
@@ -267,6 +349,14 @@ void Agc::process(IPAContext &context,
 		context.activeState.agc.valid = true;
 	}
 
+	if (stats->valid && carrySkip_) {
+		carrySkip_--;
+		frameContext.sensor.exposure = context.activeState.agc.exposure;
+		frameContext.sensor.gain = context.activeState.agc.again;
+		frameContext.sensor.vblank = context.activeState.agc.vblank;
+		return;
+	}
+
 	if (!stats->valid) {
 		/*
 		 * Use the new exposure and gain values calculated the last time
@@ -332,8 +422,13 @@ void Agc::process(IPAContext &context,
 			}
 		}
 		if (n && all) {
-			const float ratio = static_cast<float>(region) * kCells / (static_cast<float>(all) * n);
-			exposureMSV = std::clamp(exposureMSV * std::clamp(ratio, 0.25f, 4.0f),
+			float ratio = static_cast<float>(region) * kCells / (static_cast<float>(all) * n);
+			ratio = std::clamp(ratio, 1.0f / kSpotMaxRatio, kSpotMaxRatio);
+			/* A darker region asks for more light: not with highlights */
+			if (ratio < 1.0f && denom &&
+			    exposureBins[kExposureBinsCount - 1] > kSpotHighlights * denom)
+				ratio = 1.0f;
+			exposureMSV = std::clamp(exposureMSV * ratio,
 						 0.0f, static_cast<float>(kExposureBinsCount));
 		}
 	}
diff --git a/src/ipa/simple/algorithms/agc.h b/src/ipa/simple/algorithms/agc.h
index b70a29ffd..69a035461 100644
--- a/src/ipa/simple/algorithms/agc.h
+++ b/src/ipa/simple/algorithms/agc.h
@@ -33,9 +33,23 @@ public:
 
 private:
 	void updateExposure(IPAContext &context, IPAFrameContext &frameContext, double exposureMSV);
+	int32_t longExposureMax(const IPAContext &context) const;
+	int32_t timeFirstMax(const IPAContext &context) const;
+	void carryOver(IPAContext &context, IPAFrameContext &frameContext);
 
 	double maxAnalogueGain_ = 0.0;
 	double lineDurationScale_ = 1.0;
+
+	/*
+	 * Exposure of the last frame, carried over a reconfiguration as a
+	 * time: the sensor keeps the exposure in lines, and the line of
+	 * another mode can be much longer (1.83 times on the IMX519 at full
+	 * size), which overexposed every full size photo.
+	 */
+	utils::Duration lastExposureTime_{};
+	double lastGain_ = 0.0;
+	bool carryPending_ = false;
+	unsigned int carrySkip_ = 0;
 };
 
 } /* namespace ipa::soft::algorithms */
