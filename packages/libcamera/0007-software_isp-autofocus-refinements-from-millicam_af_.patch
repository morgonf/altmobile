From 3c25f2b730b8f1ec9040ddd57c82d7380f1cabeb Mon Sep 17 00:00:00 2001
From: morgonf <morgonf@altlinux.org>
Date: Sun, 27 Sep 2026 19:49:15 -0400
Subject: [PATCH 07/21] software_isp: autofocus refinements from millicam_af_6
 (da42da5, 3ac0518, 4312a90)

af.cpp and af.h taken from the branch tip. Centre-only sharpness adapted
to the per-thread statistics of v0.7.2: the autofocus band flag lives in
the per-thread SwIspStats, sharpness is normalised by the green sum.
---
 .../internal/software_isp/swisp_stats.h       |   7 +
 .../internal/software_isp/swstats_cpu.h       |   4 +
 src/ipa/simple/algorithms/af.cpp              | 120 ++++++++++--------
 src/ipa/simple/algorithms/af.h                |   5 +-
 src/ipa/simple/algorithms/agc.cpp             |   2 +-
 src/ipa/simple/algorithms/agc.h               |   2 +-
 src/libcamera/software_isp/swstats_cpu.cpp    |  16 ++-
 7 files changed, 92 insertions(+), 64 deletions(-)

diff --git a/include/libcamera/internal/software_isp/swisp_stats.h b/include/libcamera/internal/software_isp/swisp_stats.h
index c2ec20e..d1589a6 100644
--- a/include/libcamera/internal/software_isp/swisp_stats.h
+++ b/include/libcamera/internal/software_isp/swisp_stats.h
@@ -47,6 +47,13 @@ struct SwIspStats {
 	 * \brief Holds the sharpness of an image
 	 */
 	uint64_t sharpness;
+	/**
+	 * \brief The line being processed lies in the autofocus band
+	 *
+	 * Set per line by SwStatsCpu before the line statistics function runs;
+	 * every statistics buffer belongs to one thread, so no locking is needed.
+	 */
+	bool afRow;
 };
 
 } /* namespace libcamera */
diff --git a/include/libcamera/internal/software_isp/swstats_cpu.h b/include/libcamera/internal/software_isp/swstats_cpu.h
index 5518709..7423ed2 100644
--- a/include/libcamera/internal/software_isp/swstats_cpu.h
+++ b/include/libcamera/internal/software_isp/swstats_cpu.h
@@ -67,6 +67,8 @@ public:
 		    y >= (window_.y + window_.height))
 			return;
 
+		/* Autofocus sharpness is taken from the central fifth of the window */
+		stats_[statsBufferIndex].afRow = (5 * (y - window_.y)) / window_.height == 2;
 		(this->*stats0_)(src, stats_[statsBufferIndex]);
 	}
 
@@ -79,6 +81,8 @@ public:
 		    y >= (window_.y + window_.height))
 			return;
 
+		/* Autofocus sharpness is taken from the central fifth of the window */
+		stats_[statsBufferIndex].afRow = (5 * (y - window_.y)) / window_.height == 2;
 		(this->*stats2_)(src, stats_[statsBufferIndex]);
 	}
 
