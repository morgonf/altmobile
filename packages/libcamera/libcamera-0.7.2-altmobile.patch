+/* Longest exposure in lines: up to maxFrameDuration and what VBLANK allows */
+int32_t Agc::longExposureMax(const IPAContext &context) const
+{
+	const auto &agc = context.configuration.agc;
+	if (!agc.hasVblank || agc.lineDuration <= utils::Duration(0))
+		return agc.exposureMax;
