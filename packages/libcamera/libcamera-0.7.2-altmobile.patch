diff --git a/src/ipa/simple/algorithms/af.cpp b/src/ipa/simple/algorithms/af.cpp
new file mode 100644
index 000000000..8762df2f4
--- /dev/null
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -0,0 +1,359 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2025 Vasiliy Doylov <nekodevelopper@gmail.com>
+ * Copyright (C) 2026 morgonf
+ *
+ * Contrast autofocus for the software ISP
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <cmath>
+#include <stdint.h>
+
+#include <libcamera/base/log.h>
+#include <libcamera/base/span.h>
+#include "libcamera/base/utils.h"
+
+#include <libcamera/geometry.h>
+
+#include "libcamera/internal/software_isp/swisp_stats.h"
+
+#include "control_ids.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPASoftAutoFocus)
+
+namespace ipa::soft::algorithms {
+
+/*
+ * The lens travel is handled in percent (LensPosition 0..100, mapped onto
+ * the V4L2 focus control range). Contrast is measured on a 5x5 grid of the
+ * frame (SwIspStats::afSharpness), over the cells selected by AfWindows or
+ * over the central cell by default.
+ *
+ * A search has two passes: coarse with kCoarseStep over the whole travel,
+ * then fine with kFineStep within kFineSpan of the best coarse position.
+ * Only frames with fresh statistics count. The software ISP runs behind
+ * the sensor, so the statistics that arrive right after a lens move still
+ * come from a frame taken at the old position: kSettleStats statistics are
+ * skipped after every step, and one more after a jump. Without this the
+ * sharpness was credited to the wrong position, the best position came out
+ * at random and the focus never settled.
+ *
+ * After a sweep the reference sharpness is measured again at the chosen
+ * position (it is lower than the sweep maximum when the scene is noisy).
+ * In continuous mode focus is considered lost when the sharpness differs
+ * from the reference by more than kLostRatio for kLostCount statistics in
+ * a row.
+ */
+static constexpr double kCoarseStep = 10.0;
+static constexpr double kFineStep = 2.0;
+static constexpr double kFineSpan = 6.0;
+static constexpr unsigned int kSettleStats = 1;
+static constexpr double kLostRatio = 0.5;
+static constexpr unsigned int kLostCount = 4;
+
+/*
+ * Statistics used to measure the reference sharpness again after a
+ * reconfiguration, the last one counts: exposure settles meanwhile.
+ */
+static constexpr unsigned int kRebaseStats = 3;
+/* Below this normalised sharpness the region is flat: report failure */
+static constexpr uint64_t kFlatSharpness = 2;
+/* Relative change of exposure times gain between statistics: AE settled */
+static constexpr double kAeSteady = 0.03;
+
+static constexpr unsigned int kGrid = SwIspStats::kAfGrid;
+static constexpr uint32_t kCentreMask = 1u << (kGrid * kGrid / 2);
+
+Af::Af()
+{
+}
+
+int Af::init(IPAContext &context,
+	     [[maybe_unused]] const ValueNode &tuningData)
+{
+	context.ctrlMap[&controls::LensPosition] = ControlInfo(0.0f, 100.0f, 50.0f);
+	context.ctrlMap[&controls::AfTrigger] = ControlInfo(controls::AfTriggerValues);
+	context.ctrlMap[&controls::AfMode] = ControlInfo(controls::AfModeValues,
+							 ControlValue(static_cast<int32_t>(controls::AfModeContinuous)));
+	context.ctrlMap[&controls::AfMetering] = ControlInfo(controls::AfMeteringValues);
+	context.ctrlMap[&controls::AfWindows] = ControlInfo(Rectangle{}, Rectangle(65535, 65535, 65535, 65535), Rectangle{});
+	return 0;
+}
+
+int Af::configure(IPAContext &context,
+		  [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	auto &k = context.activeState.knobs;
+
+	k.focus_sweep = false;
+	k.focus_pos = lastPos_.value_or(0.0);
+	k.afMode = controls::AfModeContinuous;
+	/* A sweep cut short by the reconfiguration is not resumed */
+	k.afState = lastPos_ && lastState_ != controls::AfStateScanning
+		    ? lastState_ : controls::AfStateIdle;
+	/*
+	 * The region stays as the application last chose it. Resetting it to
+	 * the centre made the first request after a reconfiguration (a photo
+	 * at full size after a tap) change the region back and start a sweep
+	 * from the near end while the photo was being taken.
+	 */
+	if (!windowMask_)
+		windowMask_ = kCentreMask;
+	k.afMask = metering_ == controls::AfMeteringWindows ? windowMask_ : kCentreMask;
+	rebase_ = lastPos_ ? kRebaseStats : 0;
+	context.configuration.focus.skip = 1;
+	context.configuration.focus.lost = 0;
+	context.configuration.focus.sharpness_max = 0;
+	return 0;
+}
+
+/* Grid cells covered by rectangles given in pixel array coordinates */
+uint32_t Af::windowsToMask(const IPAContext &context, Span<const Rectangle> windows) const
+{
+	const Rectangle &crop = context.sensorInfo.analogCrop;
+	uint32_t mask = 0;
+
+	if (crop.width == 0 || crop.height == 0)
+		return kCentreMask;
+
+	for (const Rectangle &r : windows) {
+		auto cell = [](int64_t v, int64_t origin, uint64_t size) {
+			return static_cast<int>(std::clamp<int64_t>((v - origin) * kGrid / static_cast<int64_t>(size),
+								    0, kGrid - 1));
+		};
+		const int x0 = cell(r.x, crop.x, crop.width);
+		const int x1 = cell(r.x + r.width - 1, crop.x, crop.width);
+		const int y0 = cell(r.y, crop.y, crop.height);
+		const int y1 = cell(r.y + r.height - 1, crop.y, crop.height);
+		for (int y = y0; y <= y1; y++)
+			for (int x = x0; x <= x1; x++)
+				mask |= 1u << (y * kGrid + x);
+	}
+
+	return mask ? mask : kCentreMask;
+}
+
+void Af::queueRequest(typename Module::Context &context,
+		      [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] typename Module::FrameContext &frameContext,
+		      const ControlList &controls)
+{
+	auto &k = context.activeState.knobs;
+
+	const auto &mode = controls.get(controls::AfMode);
+	if (mode && *mode != k.afMode) {
+		k.afMode = *mode;
+		if (k.afMode == controls::AfModeManual || k.afMode == controls::AfModeAuto) {
+			k.focus_sweep = false;
+			k.afState = controls::AfStateIdle;
+		} else if (k.afMode == controls::AfModeContinuous && !*k.focus_sweep) {
+			/*
+			 * Back to continuous focus, e.g. after a flash photo held
+			 * the lens: keep it and measure the reference sharpness
+			 * again. A scene that changed still triggers a sweep
+			 * through the focus loss detection.
+			 */
+			rebase_ = kRebaseStats;
+		}
+	}
+
+	const auto &metering = controls.get(controls::AfMetering);
+	if (metering)
+		metering_ = *metering;
+	const auto &windows = controls.get(controls::AfWindows);
+	if (windows)
+		windowMask_ = windowsToMask(context, *windows);
+	const uint32_t mask = metering_ == controls::AfMeteringWindows ? windowMask_ : kCentreMask;
+	if (mask != k.afMask) {
+		k.afMask = mask;
+		/*
+		 * New region in continuous mode. A sweep under way restarts,
+		 * since its sharpness so far belongs to the old region.
+		 * Otherwise the lens stays and the reference sharpness is
+		 * measured again: a tap comes with AfTriggerStart anyway, and
+		 * a return to the centre (the tap region timing out) swept the
+		 * whole travel for nothing. A scene that changed still triggers
+		 * a sweep through the focus loss detection.
+		 */
+		if (k.afMode == controls::AfModeContinuous) {
+			if (*k.focus_sweep)
+				restart(context);
+			else
+				rebase_ = kRebaseStats;
+		}
+	}
+
+	const auto &pos = controls.get(controls::LensPosition);
+	if (pos && k.afMode == controls::AfModeManual) {
+		k.focus_pos = std::clamp<double>(*pos, 0.0, 100.0);
+		LOG(IPASoftAutoFocus, Debug) << "Setting focus position to " << *pos;
+	}
+
+	const auto &trigger = controls.get(controls::AfTrigger);
+	if (trigger && k.afMode != controls::AfModeManual) {
+		if (*trigger == controls::AfTriggerStart) {
+			restart(context);
+		} else if (*trigger == controls::AfTriggerCancel && *k.focus_sweep) {
+			k.focus_sweep = false;
+			k.afState = controls::AfStateIdle;
+		}
+	}
+}
+
+void Af::updateFocus(IPAContext &context, IPAFrameContext &frameContext)
+{
+	/* Percent of the lens travel, offset by the control minimum */
+	frameContext.lens.focus_pos = context.configuration.focus.focus_min +
+				      context.activeState.knobs.focus_pos.value_or(50.0) / 100.0 *
+				      (context.configuration.focus.focus_max - context.configuration.focus.focus_min);
+}
+
+void Af::restart(IPAContext &context)
+{
+	auto &f = context.configuration.focus;
+	auto &k = context.activeState.knobs;
+
+	steps_ = 0;
+	f.phase = 0;
+	f.lost = 0;
+	f.focus_max_pos = 0;
+	f.sharpness_max = 0;
+	f.start = 0;
+	f.stop = 100;
+	f.step = kCoarseStep;
+	f.skip = kSettleStats + 1;
+	k.focus_pos = 0;
+	k.focus_sweep = true;
+	k.afState = controls::AfStateScanning;
+	LOG(IPASoftAutoFocus, Debug) << "Starting focus sweep, cells 0x" << std::hex << k.afMask;
+}
+
+/* Normalised sharpness over the selected cells */
+uint64_t Af::regionSharpness(const IPAContext &context, const SwIspStats *stats) const
+{
+	const uint32_t mask = context.activeState.knobs.afMask;
+	uint64_t sharp = 0, green = 0;
+
+	for (unsigned int i = 0; i < kGrid * kGrid; i++) {
+		if (!(mask & (1u << i)))
+			continue;
+		sharp += stats->afSharpness[i];
+		green += stats->afGreen[i];
+	}
+
+	return green ? 1000 * sharp / green : 0;
+}
+
+void Af::step(IPAContext &context, double &focus_pos, uint64_t sharp, bool &sweep)
+{
+	auto &f = context.configuration.focus;
+	auto &k = context.activeState.knobs;
+
+	steps_++;
+	/* The lens needs a moment to settle after a jump */
+	if (f.skip != 0) {
+		f.skip--;
+		return;
+	}
+
+	if (!sweep) {
+		if (k.afMode != controls::AfModeContinuous)
+			return;
+		/*
+		 * Exposure still moving: the sharpness of such frames is no
+		 * reference and says nothing about the focus (clipped or noisy
+		 * frames after a tap region timed out lost the focus for
+		 * nothing). Compare again once it settled.
+		 */
+		if (aeMoving_)
+			return;
+		/* Kept focus after a reconfiguration: new reference sharpness */
+		if (rebase_) {
+			rebase_--;
+			f.sharpness_max = sharp;
+			f.lost = 0;
+			return;
+		}
+		/* A flat scene (no sharpness at all) gives nothing to refocus on */
+		const double dev = f.sharpness_max
+			? static_cast<double>(utils::abs_diff(sharp, f.sharpness_max)) / f.sharpness_max
+			: (sharp > kFlatSharpness ? 1.0 : 0.0);
+		f.lost = dev > kLostRatio ? f.lost + 1 : 0;
+		if (f.lost >= kLostCount) {
+			LOG(IPASoftAutoFocus, Debug) << "Focus lost: " << sharp << " vs " << f.sharpness_max;
+			restart(context);
+		}
+		return;
+	}
+
+	LOG(IPASoftAutoFocus, Debug) << "Sweep pos " << focus_pos << " sharpness " << sharp;
+	if (sharp > f.sharpness_max) {
+		f.sharpness_max = sharp;
+		f.focus_max_pos = focus_pos;
+	}
+
+	focus_pos += f.step;
+	if (focus_pos <= f.stop) {
+		f.skip = kSettleStats;
+		return;
+	}
+
+	if (f.phase == 0) {
+		f.phase = 1;
+		f.start = std::clamp(f.focus_max_pos - kFineSpan, 0.0, 100.0);
+		f.stop = std::clamp(f.focus_max_pos + kFineSpan, 0.0, 100.0);
+		f.step = kFineStep;
+		f.skip = kSettleStats + 1;
+		f.sharpness_max = 0;
+		focus_pos = f.start;
+		return;
+	}
+
+	/* Done: keep sharpness_max to detect a scene change */
+	sweep = false;
+	f.lost = 0;
+	f.skip = kSettleStats + 1;
+	rebase_ = kRebaseStats;
+	focus_pos = f.focus_max_pos;
+	k.afState = f.sharpness_max > kFlatSharpness ? controls::AfStateFocused
+						     : controls::AfStateFailed;
+	LOG(IPASoftAutoFocus, Debug) << "Sweep end. Best focus: " << f.focus_max_pos
+				     << " sharpness " << f.sharpness_max << " steps " << steps_;
+}
+
+void Af::process(IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 ControlList &metadata)
+{
+	auto &k = context.activeState.knobs;
+
+	/* Statistics are computed only for some frames */
+	if (stats->valid) {
+		const auto &agc = context.activeState.agc;
+		const double ae = agc.exposure * agc.again;
+		aeMoving_ = lastAe_ > 0.0 && std::abs(ae - lastAe_) > kAeSteady * lastAe_;
+		lastAe_ = ae;
+	}
+	if (stats->valid && k.afMode != controls::AfModeManual)
+		step(context, k.focus_pos.value(), regionSharpness(context, stats),
+		     k.focus_sweep.value());
+
+	updateFocus(context, frameContext);
+	lastPos_ = k.focus_pos.value();
+	lastState_ = k.afState;
+	metadata.set(controls::LensPosition, static_cast<float>(k.focus_pos.value()));
+	metadata.set(controls::AfState, k.afState);
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
