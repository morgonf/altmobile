 .../internal/software_isp/swstats_cpu.h       |  6 +++
 src/libcamera/shaders/bayer_1x_packed.frag    | 40 +++++++++++++++++
 src/libcamera/software_isp/debayer.h          |  7 +++
 src/libcamera/software_isp/debayer_cpu.cpp    |  5 +++
