@@ -99,6 +104,19 @@ SoftwareIsp::SoftwareIsp(PipelineHandler *pipe, const CameraSensor *sensor,
 
 	const CameraManager &cm = *pipe->cameraManager();
 
+	/*
+	 * Sensors with a Quad Bayer colour filter. Their binned modes are an
+	 * ordinary Bayer mosaic, full size frames need remosaicing.
+	 */
+	static const std::array<std::string_view, 1> quadBayerSensors = {
+		"imx371", /* OnePlus 6 and 6T front camera */
+	};
+	quadBayerSensor_ = std::find(quadBayerSensors.begin(), quadBayerSensors.end(),
+				     sensor->model()) != quadBayerSensors.end();
+	const auto pixelArray = sensor->properties().get(properties::PixelArraySize);
+	if (pixelArray)
+		pixelArrayWidth_ = pixelArray->width;
+
 	auto stats = std::make_unique<SwStatsCpu>(cm);
 	if (!stats->isValid()) {
 		LOG(SoftwareIsp, Error) << "Failed to create SwStatsCpu object";
@@ -292,6 +310,13 @@ int SoftwareIsp::configure(const StreamConfiguration &inputCfg,
 	if (ret < 0)
 		return ret;
 
+	/* Wider than half the array: not binned, still a Quad Bayer mosaic */
+	const bool quadBayer = quadBayerSensor_ &&
+			       inputCfg.size.width > pixelArrayWidth_ / 2;
+	debayer_->setQuadBayer(quadBayer);
+	if (quadBayer)
+		LOG(SoftwareIsp, Info) << "Remosaicing the Quad Bayer input";
+
 	ret = debayer_->configure(inputCfg, outputCfgs, ccmEnabled_);
 	if (ret < 0)
