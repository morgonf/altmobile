diff --git a/src/libcamera/software_isp/swstats_cpu.cpp b/src/libcamera/software_isp/swstats_cpu.cpp
index 752de16..a38655c 100644
--- a/src/libcamera/software_isp/swstats_cpu.cpp
+++ b/src/libcamera/software_isp/swstats_cpu.cpp
@@ -350,6 +350,35 @@ void SwStatsCpu::statsGBRG10PLine0(const uint8_t *src[], SwIspStats &stats)
 	SWSTATS_FINISH_LINE_STATS()
 }
 
+/*
+ * Quad Bayer RGGB: every colour covers a 2x2 block, so one pixel of each
+ * colour is two pixels apart. src[2] is two lines below src[1] (lineGap_),
+ * and the second pixel of a pair is two pixels to the right, that is the
+ * byte after next in the 5-byte group of 4 pixels.
+ */
+void SwStatsCpu::statsQuadRGGB10PLine0(const uint8_t *src[], SwIspStats &stats)
+{
+	const uint8_t *src0 = src[1] + window_.x * 5 / 4;
+	const uint8_t *src1 = src[2] + window_.x * 5 / 4;
+	const unsigned int widthInBytes = window_.width * 5 / 4;
+
+	SWSTATS_START_LINE_STATS(uint8_t)
+	afSpan = widthInBytes;
+
+	/* x += 5 sample one pixel of each colour per 4x4 tile */
+	for (unsigned int x = 0; x < widthInBytes; x += 5) {
+		r = src0[x];
+		g = src0[x + 2];
+		g2 = src1[x];
+		b = src1[x + 2];
+		g = (g + g2) / 2;
+		/* Data is already 8 bits, divide by 1 */
+		SWSTATS_ACCUMULATE_LINE_STATS(1)
+	}
+
+	SWSTATS_FINISH_LINE_STATS()
+}
+
 void SwStatsCpu::statsBGGR12PLine0(const uint8_t *src[], SwIspStats &stats)
 {
 	const uint8_t *src0 = src[1] + window_.x * 3 / 2;
@@ -515,6 +544,7 @@ int SwStatsCpu::configure(const StreamConfiguration &inputCfg, unsigned int stat
 {
 	stride_ = inputCfg.stride;
 	stats_.resize(statsBufferCount);
+	lineGap_ = 1;
 
 	BayerFormat bayerFormat =
 		BayerFormat::fromPixelFormat(inputCfg.pixelFormat);
@@ -555,6 +585,18 @@ int SwStatsCpu::configure(const StreamConfiguration &inputCfg, unsigned int stat
 		sumShift_ = 0;
 		processFrame_ = &SwStatsCpu::processBayerFrame2;
 
+		if (quadBayer_) {
+			if (bitDepth != 10 || bayerFormat.order != BayerFormat::RGGB) {
+				LOG(SwStatsCpu, Error)
+					<< "Quad Bayer only supported for RGGB 10-bit packed";
+				return -EINVAL;
+			}
+			stats0_ = &SwStatsCpu::statsQuadRGGB10PLine0;
+			swapLines_ = false;
+			lineGap_ = 2;
+			return 0;
+		}
+
 		switch (bayerFormat.order) {
 		case BayerFormat::BGGR:
 		case BayerFormat::GRBG:
@@ -634,7 +676,7 @@ void SwStatsCpu::processBayerFrame2(MappedFrameBuffer &in)
 
 		/* linePointers[0] is not used by any stats0_ functions */
 		linePointers[1] = src;
-		linePointers[2] = src + stride_;
+		linePointers[2] = src + stride_ * lineGap_;
 		/* y is relative to the window here */
 		stats_[0].afRow = (SwIspStats::kAfGrid * y) / window_.height;
 		(this->*stats0_)(linePointers, stats_[0]);
