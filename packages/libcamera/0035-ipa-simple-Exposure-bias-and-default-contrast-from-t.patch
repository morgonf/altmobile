From 40cc6b0ccaf558f4af8032986d3a79cf3d663826 Mon Sep 17 00:00:00 2001
From: morgonf <morgonf@altlinux.org>
Date: Sun, 4 Oct 2026 04:48:20 -0400
Subject: [PATCH] ipa: simple: Exposure bias and default contrast from the
 tuning file

The front camera of the OnePlus 6T (IMX371) came out hazy: the common
AGC target overexposed it (median 174 of 255, a fifth of the frame
clipped) and the plain gamma curve lifted the shadows of its low
contrast lens to grey, although the raw frame is at the black level.

Add an optional exposureBias (stops, added to the ExposureValue
control, so the user keeps the whole compensation range) to Agc and an
optional default contrast to Adjust, and use one stop down and an
S-curve of 1.3 for the IMX371.
---
 src/ipa/simple/algorithms/adjust.cpp | 14 ++++++++++----
 src/ipa/simple/algorithms/adjust.h   |  2 ++
 src/ipa/simple/algorithms/agc.cpp    |  8 +++++++-
 src/ipa/simple/algorithms/agc.h      |  1 +
 src/ipa/simple/data/imx371.yaml      |  5 +++++
 5 files changed, 25 insertions(+), 5 deletions(-)

diff --git a/src/ipa/simple/algorithms/adjust.cpp b/src/ipa/simple/algorithms/adjust.cpp
index 8bf39c4c8..e68353b20 100644
--- a/src/ipa/simple/algorithms/adjust.cpp
+++ b/src/ipa/simple/algorithms/adjust.cpp
@@ -24,12 +24,18 @@ constexpr float kDefaultSaturation = 1.0f;
 
 LOG_DEFINE_CATEGORY(IPASoftAdjust)
 
-int Adjust::init(IPAContext &context, [[maybe_unused]] const ValueNode &tuningData)
+int Adjust::init(IPAContext &context, const ValueNode &tuningData)
 {
+	/*
+	 * Optional default contrast: the plain gamma curve lifts the shadows
+	 * of a low contrast lens to grey, an S-curve brings them down.
+	 */
+	defaultContrast_ = tuningData["contrast"].get<float>(kDefaultContrast);
+
 	context.ctrlMap[&controls::Gamma] =
 		ControlInfo(0.1f, 10.0f, kDefaultGamma);
 	context.ctrlMap[&controls::Contrast] =
-		ControlInfo(0.0f, 2.0f, kDefaultContrast);
+		ControlInfo(0.0f, 2.0f, defaultContrast_);
 	if (context.ccmEnabled)
 		context.ctrlMap[&controls::Saturation] =
 			ControlInfo(0.0f, 2.0f, kDefaultSaturation);
@@ -107,7 +113,7 @@ void Adjust::prepare(IPAContext &context,
 	}
 
 	params->gamma = 1.0 / context.activeState.knobs.gamma;
-	const float contrast = context.activeState.knobs.contrast.value_or(kDefaultContrast);
+	const float contrast = context.activeState.knobs.contrast.value_or(defaultContrast_);
 	params->contrastExp = tan(std::clamp(contrast * M_PI_4, 0.0, M_PI_2 - 0.00001));
 }
 
@@ -121,7 +127,7 @@ void Adjust::process([[maybe_unused]] IPAContext &context,
 	metadata.set(controls::Gamma, gamma);
 
 	const auto &contrast = frameContext.contrast;
-	metadata.set(controls::Contrast, contrast.value_or(kDefaultContrast));
+	metadata.set(controls::Contrast, contrast.value_or(defaultContrast_));
 
 	const auto &saturation = frameContext.saturation;
 	metadata.set(controls::Saturation, saturation.value_or(kDefaultSaturation));
diff --git a/src/ipa/simple/algorithms/adjust.h b/src/ipa/simple/algorithms/adjust.h
index 49c1f26c3..65949cb76 100644
--- a/src/ipa/simple/algorithms/adjust.h
+++ b/src/ipa/simple/algorithms/adjust.h
@@ -43,6 +43,8 @@ public:
 
 private:
 	void applySaturation(Matrix<float, 3, 3> &ccm, float saturation);
+
+	float defaultContrast_ = 1.0f;
 };
 
 } /* namespace ipa::soft::algorithms */
diff --git a/src/ipa/simple/algorithms/agc.cpp b/src/ipa/simple/algorithms/agc.cpp
index 94930b838..ab6a95c50 100644
--- a/src/ipa/simple/algorithms/agc.cpp
+++ b/src/ipa/simple/algorithms/agc.cpp
@@ -123,6 +123,12 @@ int Agc::init(IPAContext &context, const ValueNode &tuningData)
 	 * reported exposure time are off by this factor.
 	 */
 	lineDurationScale_ = tuningData["lineDurationScale"].get<double>(1.0);
+	/*
+	 * Optional exposure offset in stops, added to the ExposureValue
+	 * control: a sensor that comes out too bright with the common target
+	 * keeps the whole range of the compensation for the user.
+	 */
+	exposureBias_ = tuningData["exposureBias"].get<double>(0.0);
 
 	context.ctrlMap[&controls::AeEnable] = ControlInfo(false, true, true);
 	context.ctrlMap[&controls::Brightness] = ControlInfo(0.0f, 2.0f, 1.0f);
@@ -242,7 +248,7 @@ void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext, dou
 	int32_t &exposure = frameContext.sensor.exposure;
 	double &again = frameContext.sensor.gain;
 	const auto brightness = context.activeState.knobs.brightness.value_or(1.0);
-	const auto ev = context.activeState.knobs.exposure_value.value_or(0.0);
+	const auto ev = context.activeState.knobs.exposure_value.value_or(0.0) + exposureBias_;
 	/* Brighter target for positive compensation: the scene looks darker */
 	exposureMSV /= brightness * std::exp2(ev);
 
diff --git a/src/ipa/simple/algorithms/agc.h b/src/ipa/simple/algorithms/agc.h
index 69a035461..ffe5e0009 100644
--- a/src/ipa/simple/algorithms/agc.h
+++ b/src/ipa/simple/algorithms/agc.h
@@ -39,6 +39,7 @@ private:
 
 	double maxAnalogueGain_ = 0.0;
 	double lineDurationScale_ = 1.0;
+	double exposureBias_ = 0.0;
 
 	/*
 	 * Exposure of the last frame, carried over a reconfiguration as a
diff --git a/src/ipa/simple/data/imx371.yaml b/src/ipa/simple/data/imx371.yaml
index 7a3ad9901..82af5305d 100644
--- a/src/ipa/simple/data/imx371.yaml
+++ b/src/ipa/simple/data/imx371.yaml
@@ -39,8 +39,13 @@ algorithms:
           ccm: [ 1.3485, -0.0542, -0.2942,
                  -0.2218, 1.7768, -0.555,
                  -0.074, -0.5534, 1.6274 ]
+  # The lens of the front camera has little contrast and the common
+  # target overexposed it (median 174 of 255, a fifth of the frame
+  # clipped): one stop darker and an S-curve, measured 04.10.2026.
   - Adjust:
+      contrast: 1.3
   - Agc:
       maxAnalogueGain: 8.0
+      exposureBias: -1.0
   - Af:
 ...
-- 
