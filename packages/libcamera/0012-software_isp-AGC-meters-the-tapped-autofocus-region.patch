From 9b20abfc2e3c45e65c4308559b2059f7664de0b6 Mon Sep 17 00:00:00 2001
From: morgonf <morgonf@altlinux.org>
Date: Mon, 28 Sep 2026 01:29:33 -0400
Subject: [PATCH 12/15] software_isp: AGC meters the tapped autofocus region

When the application chooses AF windows, the frame MSV is scaled by the
brightness of the selected grid cells relative to the frame (1/4..4).
---
 src/ipa/simple/algorithms/agc.cpp | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/src/ipa/simple/algorithms/agc.cpp b/src/ipa/simple/algorithms/agc.cpp
index 057f190..59176d1 100644
--- a/src/ipa/simple/algorithms/agc.cpp
+++ b/src/ipa/simple/algorithms/agc.cpp
@@ -248,6 +248,32 @@ void Agc::process(IPAContext &context,
 	}
 
 	float exposureMSV = (denom == 0 ? 0 : static_cast<float>(num) / denom);
+
+	/*
+	 * Spot metering on the region chosen for autofocus (tap to focus): scale
+	 * the frame MSV by how much brighter or darker the region is than the
+	 * frame, within 1/4..4. The central cell alone is the default AF region,
+	 * then the whole frame is metered.
+	 */
+	constexpr unsigned int kCells = SwIspStats::kAfGrid * SwIspStats::kAfGrid;
+	const uint32_t mask = context.activeState.knobs.afMask;
+	if (mask && mask != (1u << (kCells / 2))) {
+		uint64_t region = 0, all = 0;
+		unsigned int n = 0;
+		for (unsigned int i = 0; i < kCells; i++) {
+			all += stats->afGreen[i];
+			if (mask & (1u << i)) {
+				region += stats->afGreen[i];
+				n++;
+			}
+		}
+		if (n && all) {
+			const float ratio = static_cast<float>(region) * kCells / (static_cast<float>(all) * n);
+			exposureMSV = std::clamp(exposureMSV * std::clamp(ratio, 0.25f, 4.0f),
+						 0.0f, static_cast<float>(kExposureBinsCount));
+		}
+	}
+
 	updateExposure(context, frameContext, exposureMSV);
 }
 
