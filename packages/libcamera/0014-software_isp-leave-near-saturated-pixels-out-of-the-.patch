From 2ecceb1605f002857d76b320b77efb5f371d3d25 Mon Sep 17 00:00:00 2001
From: morgonf <morgonf@altlinux.org>
Date: Mon, 28 Sep 2026 01:40:00 -0400
Subject: [PATCH 14/21] software_isp: leave near-saturated pixels out of the
 white balance sums

Clipped pixels have all channels at the maximum and look neutral while
their colour is unknown; a bright window pulled the grey world estimate
off. The statistics count the pixels in the sums for the black level
offset.
---
 .../libcamera/internal/software_isp/swisp_stats.h |  5 +++++
 src/ipa/simple/algorithms/awb.cpp                 |  5 +++--
 src/libcamera/software_isp/swstats_cpu.cpp        | 15 ++++++++++++---
 3 files changed, 20 insertions(+), 5 deletions(-)

diff --git a/include/libcamera/internal/software_isp/swisp_stats.h b/include/libcamera/internal/software_isp/swisp_stats.h
index dae0515..d2cab49 100644
--- a/include/libcamera/internal/software_isp/swisp_stats.h
+++ b/include/libcamera/internal/software_isp/swisp_stats.h
@@ -31,6 +31,11 @@ struct SwIspStats {
 	 * \brief Sums of colour channels of all the sampled pixels
 	 */
 	RGB<uint64_t> sum_;
+	/**
+	 * \brief Number of pixels in sum_: near-saturated ones are left out,
+	 *        their colour is unknown and would bias white balance
+	 */
+	uint64_t sumCount;
 	/**
 	 * \brief Number of bins in the yHistogram
 	 */
diff --git a/src/ipa/simple/algorithms/awb.cpp b/src/ipa/simple/algorithms/awb.cpp
index 05155c8..38430c0 100644
--- a/src/ipa/simple/algorithms/awb.cpp
+++ b/src/ipa/simple/algorithms/awb.cpp
@@ -63,8 +63,9 @@ void Awb::process(IPAContext &context,
 	 * would be off if they were computed from the whole brightness range
 	 * rather than from the sensor range.
 	 */
-	const uint64_t nPixels = std::accumulate(
-		histogram.begin(), histogram.end(), uint64_t(0));
+	/* Only the pixels in the sums (near-saturated ones are left out) */
+	const uint64_t nPixels = stats->sumCount ? stats->sumCount
+		: std::accumulate(histogram.begin(), histogram.end(), uint64_t(0));
 	const uint64_t offset = blackLevel * nPixels;
 	const uint64_t minValid = 1;
 	/*
diff --git a/src/libcamera/software_isp/swstats_cpu.cpp b/src/libcamera/software_isp/swstats_cpu.cpp
index c7b419a..752de16 100644
--- a/src/libcamera/software_isp/swstats_cpu.cpp
+++ b/src/libcamera/software_isp/swstats_cpu.cpp
@@ -180,6 +180,7 @@ static constexpr unsigned int kBlueYMul = 29; /* 0.114 * 256 */
 	uint64_t sumR = 0;                \
 	uint64_t sumG = 0;                \
 	uint64_t sumB = 0;                \
+	uint64_t sumN = 0;                \
 	/* green two samples back, for sharpness */ \
 	pixel_t g0 = 0, g1 = 0;           \
 	unsigned int afCol;               \
@@ -189,9 +190,13 @@ static constexpr unsigned int kBlueYMul = 29; /* 0.114 * 256 */
 	uint64_t afGreen[SwIspStats::kAfGrid] = {};
 
 #define SWSTATS_ACCUMULATE_LINE_STATS(div) \
-	sumR += r;                         \
-	sumG += g;                         \
-	sumB += b;                         \
+	/* 240 of 255 at 8 bits, scaled for 10 and 12 bits by div */ \
+	if (r < 240 * (div) && g < 240 * (div) && b < 240 * (div)) { \
+		sumR += r;                 \
+		sumG += g;                 \
+		sumB += b;                 \
+		sumN++;                    \
+	}                                  \
                                            \
 	yVal = r * kRedYMul;               \
 	yVal += g * kGreenYMul;            \
@@ -208,6 +213,7 @@ static constexpr unsigned int kBlueYMul = 29; /* 0.114 * 256 */
 	stats.sum_.r() += sumR;     \
 	stats.sum_.g() += sumG;     \
 	stats.sum_.b() += sumB;     \
+	stats.sumCount += sumN;     \
 	for (unsigned int c = 0; c < SwIspStats::kAfGrid; c++) { \
 		stats.afSharpness[stats.afRow * SwIspStats::kAfGrid + c] += afSharp[c]; \
 		stats.afGreen[stats.afRow * SwIspStats::kAfGrid + c] += afGreen[c]; \
@@ -414,6 +420,7 @@ void SwStatsCpu::startFrame(uint32_t frame)
 
 	for (auto &s : stats_) {
 		s.sum_ = RGB<uint64_t>({ 0, 0, 0 });
+		s.sumCount = 0;
 		s.sharpness = 0;
 		s.afSharpness.fill(0);
 		s.afGreen.fill(0);
@@ -437,8 +444,10 @@ void SwStatsCpu::finishFrame(uint32_t frame, uint32_t bufferId)
 		sharedStats_->afSharpness.fill(0);
 		sharedStats_->afGreen.fill(0);
 		sharedStats_->yHistogram.fill(0);
+		sharedStats_->sumCount = 0;
 		for (const auto &s : stats_) {
 			sharedStats_->sum_ += s.sum_;
+			sharedStats_->sumCount += s.sumCount;
 			for (unsigned int i = 0; i < s.afSharpness.size(); i++) {
 				sharedStats_->afSharpness[i] += s.afSharpness[i];
 				sharedStats_->afGreen[i] += s.afGreen[i];
-- 
