diff --git a/src/libcamera/shaders/bayer_1x_packed.frag b/src/libcamera/shaders/bayer_1x_packed.frag
index 6d621f6aa..7df188830 100644
--- a/src/libcamera/shaders/bayer_1x_packed.frag
+++ b/src/libcamera/shaders/bayer_1x_packed.frag
@@ -70,6 +70,7 @@ uniform mat3 ccm;
 uniform vec3 blacklevel;
 uniform float gamma;
 uniform float contrastExp;
+uniform float demosaicSharpness;
 
 float apply_contrast(float value)
 {
@@ -80,6 +81,22 @@ float apply_contrast(float value)
 		return 1.0 - 0.5 * pow((1.0 - value) / 0.5, contrastExp);
 }
 
+/*
+ * Sample of the pixel at integer pixel coordinates, for the 5x5
+ * neighbourhood of the demosaic below. The MS byte of every pixel is read,
+ * as for the centre: RAW10P keeps 4 pixels in 5 bytes, RAW12P 2 in 3.
+ */
+float pix_fetch(vec2 pixel)
+{
+	pixel = clamp(pixel, vec2(0.0), tex_size - 1.0);
+#if defined(RAW10P)
+	float byte_x = 5.0 * floor(pixel.x / 4.0) + (pixel.x - 4.0 * floor(pixel.x / 4.0));
+#else
+	float byte_x = 3.0 * floor(pixel.x / 2.0) + (pixel.x - 2.0 * floor(pixel.x / 2.0));
+#endif
+	return texture2D(tex_y, vec2(byte_x, pixel.y) * tex_step).r;
+}
+
 #if defined(QUAD_BAYER)
 /*
  * Quad Bayer: every colour covers a 2x2 block of pixels. Swapping pixels 1
@@ -109,162 +126,67 @@ void main(void)
 	vec3 rgb;
 
 	/*
-	 * center_bytes holds the coordinates of the MS byte of the pixel
-	 * being sampled on the [0, stride-1/height-1] range.
-	 * center_pixel holds the coordinates of the pixel being sampled
-	 * on the [0, width/height-1] range.
-	 */
-	vec2 center_bytes;
-	vec2 center_pixel;
-
-	/*
-	 * x- and y-positions of the adjacent pixels on the [0, 1] range.
-	 */
-	vec2 xcoords;
-	vec2 ycoords;
-
-	/*
-	 * The coordinates passed to the shader in textureOut may point
-	 * to a place in between the pixels if the texture format doesn't
-	 * match the image format. In particular, MIPI packed raw Bayer
-	 * formats don't have a matching texture format.
-	 * In this case align the coordinates to the left nearest pixel
-	 * by hand.
+	 * center_pixel holds the coordinates of the pixel being sampled on
+	 * the [0, width/height-1] range. The coordinates passed in textureOut
+	 * may point in between the pixels when the texture format does not
+	 * match the image format (MIPI packed raw Bayer), align them to the
+	 * left nearest pixel.
 	 */
-	center_pixel = floor(textureOut * tex_size);
-	center_bytes.y = center_pixel.y;
-
-	/*
-	 * Add a small number (a few mantissa's LSBs) to avoid float
-	 * representation issues. Maybe paranoic.
-	 */
-	center_bytes.x = BPP * center_pixel.x + 0.02;
-
-	float fract_x = fract(center_bytes.x);
-
-	/*
-	 * The below floor() call ensures that center_bytes.x points
-	 * at one of the bytes representing the 8 higher bits of
-	 * the pixel value, not at the byte containing the LS bits
-	 * of the group of the pixels.
-	 */
-	center_bytes.x = floor(center_bytes.x);
-	center_bytes *= tex_step;
-
-	xcoords = center_bytes.x + vec2(-tex_step.x, tex_step.x);
-	ycoords = center_bytes.y + vec2(-tex_step.y, tex_step.y);
-
-	/*
-	 * If xcoords[0] points at the byte containing the LS bits
-	 * of the previous group of the pixels, move xcoords[0] one
-	 * byte back.
-	 */
-	xcoords[0] += (fract_x < THRESHOLD_L) ? -tex_step.x : 0.0;
-
-	/*
-	 * If xcoords[1] points at the byte containing the LS bits
-	 * of the current group of the pixels, move xcoords[1] one
-	 * byte forward.
-	 */
-	xcoords[1] += (fract_x > THRESHOLD_H) ? tex_step.x : 0.0;
+	vec2 center_pixel = floor(textureOut * tex_size);
 
 	vec2 alternate = mod(center_pixel.xy + tex_bayer_first_red, 2.0);
 	bool even_col = alternate.x < 1.0;
 	bool even_row = alternate.y < 1.0;
 
 	/*
-	 * We need to sample the central pixel and the ones with offset
-	 * of -1 to +1 pixel in both X and Y directions. Let's name these
-	 * pixels as below, where C is the central pixel:
-	 *
-	 *   +----+----+----+----+
-	 *   | \ x|    |    |    |
-	 *   |y \ | -1 |  0 | +1 |
-	 *   +----+----+----+----+
-	 *   | +1 | D2 | A1 | D3 |
-	 *   +----+----+----+----+
-	 *   |  0 | B0 |  C | B1 |
-	 *   +----+----+----+----+
-	 *   | -1 | D0 | A0 | D1 |
-	 *   +----+----+----+----+
-	 *
-	 * In the below equations (0,-1).r means "r component of the texel
-	 * shifted by -tex_step.y from the center_bytes one" etc.
-	 *
-	 * In the even row / even column (EE) case the colour values are:
-	 *   R = C = (0,0).r,
-	 *   G = (A0 + A1 + B0 + B1) / 4.0 =
-	 *       ( (0,-1).r + (0,1).r + (-1,0).r + (1,0).r ) / 4.0,
-	 *   B = (D0 + D1 + D2 + D3) / 4.0 =
-	 *       ( (-1,-1).r + (1,-1).r + (-1,1).r + (1,1).r ) / 4.0
-	 *
-	 * For even row / odd column (EO):
-	 *   R = (B0 + B1) / 2.0 = ( (-1,0).r + (1,0).r ) / 2.0,
-	 *   G = C = (0,0).r,
-	 *   B = (A0 + A1) / 2.0 = ( (0,-1).r + (0,1).r ) / 2.0
-	 *
-	 * For odd row / even column (OE):
-	 *   R = (A0 + A1) / 2.0 = ( (0,-1).r + (0,1).r ) / 2.0,
-	 *   G = C = (0,0).r,
-	 *   B = (B0 + B1) / 2.0 = ( (-1,0).r + (1,0).r ) / 2.0
-	 *
-	 * For odd row / odd column (OO):
-	 *   R = (D0 + D1 + D2 + D3) / 4.0 =
-	 *       ( (-1,-1).r + (1,-1).r + (-1,1).r + (1,1).r ) / 4.0,
-	 *   G = (A0 + A1 + B0 + B1) / 4.0 =
-	 *       ( (0,-1).r + (0,1).r + (-1,0).r + (1,0).r ) / 4.0,
-	 *   B = C = (0,0).r
-	 */
-
-	/*
-	 * Fetch the values and precalculate the terms:
-	 *   patterns.x = (A0 + A1) / 2.0
-	 *   patterns.y = (B0 + B1) / 2.0
-	 *   patterns.z = (A0 + A1 + B0 + B1) / 4.0
-	 *   patterns.w = (D0 + D1 + D2 + D3) / 4.0
+	 * Demosaic of Malvar, He and Cutler (ICASSP 2004): bilinear
+	 * interpolation corrected by the gradient of the colour known at the
+	 * centre, on a 5x5 neighbourhood (ALT Mobile; the bilinear 3x3 one
+	 * blurred fine detail). With A the vertical, B the horizontal and D
+	 * the diagonal neighbours and Ev, Eh the same colour two pixels away
+	 * vertically and horizontally, sums of the pairs and the four:
+	 *   G at R or B          (4C + 2(A + B) - (Ev + Eh)) / 8
+	 *   colour of the row    (5C + 4B - D - Eh + Ev / 2) / 8
+	 *   colour of the column (5C + 4A - D - Ev + Eh / 2) / 8
+	 *   B at R, R at B       (6C + 2D - 3/2 (Ev + Eh)) / 8
 	 */
 #if defined(QUAD_BAYER)
-	#define qfetch(dx, dy) quad_fetch(center_pixel + vec2(dx, dy))
-
-	float C = qfetch(0.0, 0.0);
-	vec4 patterns = vec4(
-		qfetch(0.0, -1.0),	/* A0: (0,-1) */
-		qfetch(-1.0, 0.0),	/* B0: (-1,0) */
-		qfetch(-1.0, -1.0),	/* D0: (-1,-1) */
-		qfetch(1.0, -1.0));	/* D1: (1,-1) */
-	vec4 temp = vec4(
-		qfetch(0.0, 1.0),	/* A1: (0,1) */
-		qfetch(1.0, 0.0),	/* B1: (1,0) */
-		qfetch(1.0, 1.0),	/* D3: (1,1) */
-		qfetch(-1.0, 1.0));	/* D2: (-1,1) */
+	#define nfetch(dx, dy) quad_fetch(center_pixel + vec2(dx, dy))
 #else
-	#define fetch(x, y) texture2D(tex_y, vec2(x, y)).r
-
-	float C = texture2D(tex_y, center_bytes).r;
-	vec4 patterns = vec4(
-		fetch(center_bytes.x, ycoords[0]),	/* A0: (0,-1) */
-		fetch(xcoords[0], center_bytes.y),	/* B0: (-1,0) */
-		fetch(xcoords[0], ycoords[0]),		/* D0: (-1,-1) */
-		fetch(xcoords[1], ycoords[0]));		/* D1: (1,-1) */
-	vec4 temp = vec4(
-		fetch(center_bytes.x, ycoords[1]),	/* A1: (0,1) */
-		fetch(xcoords[1], center_bytes.y),	/* B1: (1,0) */
-		fetch(xcoords[1], ycoords[1]),		/* D3: (1,1) */
-		fetch(xcoords[0], ycoords[1]));		/* D2: (-1,1) */
+	#define nfetch(dx, dy) pix_fetch(center_pixel + vec2(dx, dy))
 #endif
-	patterns = (patterns + temp) * 0.5;
-		/* .x = (A0 + A1) / 2.0, .y = (B0 + B1) / 2.0 */
-		/* .z = (D0 + D3) / 2.0, .w = (D1 + D2) / 2.0 */
-	patterns.w = (patterns.z + patterns.w) * 0.5;
-	patterns.z = (patterns.x + patterns.y) * 0.5;
 
+	float C = nfetch(0.0, 0.0);
+	float A = nfetch(0.0, -1.0) + nfetch(0.0, 1.0);
+	float B = nfetch(-1.0, 0.0) + nfetch(1.0, 0.0);
+	float D = nfetch(-1.0, -1.0) + nfetch(1.0, -1.0) +
+		  nfetch(-1.0, 1.0) + nfetch(1.0, 1.0);
+	float Ev = nfetch(0.0, -2.0) + nfetch(0.0, 2.0);
+	float Eh = nfetch(-2.0, 0.0) + nfetch(2.0, 0.0);
+
+	float g_at_rb = (4.0 * C + 2.0 * (A + B) - (Ev + Eh)) * 0.125;
+	float row = (5.0 * C + 4.0 * B - D - Eh + 0.5 * Ev) * 0.125;
+	float col = (5.0 * C + 4.0 * A - D - Ev + 0.5 * Eh) * 0.125;
+	float diag = (6.0 * C + 2.0 * D - 1.5 * (Ev + Eh)) * 0.125;
+
+	/*
+	 * The gradient correction sharpens, but also raises the noise at high
+	 * gain: demosaicSharpness (tuning file) mixes it with the bilinear
+	 * values, 0 is the plain bilinear demosaic of upstream.
+	 */
+	g_at_rb = mix((A + B) * 0.25, g_at_rb, demosaicSharpness);
+	row = mix(B * 0.5, row, demosaicSharpness);
+	col = mix(A * 0.5, col, demosaicSharpness);
+	diag = mix(D * 0.25, diag, demosaicSharpness);
+
+	/* Even row and column: R; G sites take R from the column in odd rows */
 	rgb = even_col ?
 		(even_row ?
-			vec3(C, patterns.zw) :
-			vec3(patterns.x, C, patterns.y)) :
+			vec3(C, g_at_rb, diag) :
+			vec3(col, C, row)) :
 		(even_row ?
-			vec3(patterns.y, C, patterns.x) :
-			vec3(patterns.wz, C));
+			vec3(row, C, col) :
+			vec3(diag, g_at_rb, C));
 
 	/*
 	 * \todo: Black level normalising, AWB and digital gain could be
diff --git a/src/libcamera/software_isp/debayer.cpp b/src/libcamera/software_isp/debayer.cpp
index 56446f55d..abb2dfd6c 100644
--- a/src/libcamera/software_isp/debayer.cpp
+++ b/src/libcamera/software_isp/debayer.cpp
@@ -43,6 +43,12 @@ namespace libcamera {
  * \brief Contrast value to be used as an exponent
  */
 
+/**
+ * \var DebayerParams::demosaicSharpness
+ * \brief Share of the gradient corrected (Malvar-He-Cutler) demosaic over
+ * the bilinear one, 0 to 1. Only the GPU debayer of packed formats uses it.
+ */
+
 /**
  * \class Debayer
  * \brief Base debayering class
diff --git a/src/libcamera/software_isp/debayer_egl.cpp b/src/libcamera/software_isp/debayer_egl.cpp
index 8ac8f1587..63fafd410 100644
--- a/src/libcamera/software_isp/debayer_egl.cpp
+++ b/src/libcamera/software_isp/debayer_egl.cpp
@@ -121,6 +121,7 @@ int DebayerEGL::getShaderVariableLocations(void)
 	blackLevelUniformDataIn_ = glGetUniformLocation(programId_, "blacklevel");
 	gammaUniformDataIn_ = glGetUniformLocation(programId_, "gamma");
 	contrastExpUniformDataIn_ = glGetUniformLocation(programId_, "contrastExp");
+	demosaicSharpnessUniformDataIn_ = glGetUniformLocation(programId_, "demosaicSharpness");
 
 	textureUniformStep_ = glGetUniformLocation(programId_, "tex_step");
 	textureUniformSize_ = glGetUniformLocation(programId_, "tex_size");
@@ -507,6 +508,9 @@ void DebayerEGL::setShaderVariableValues(eGLImage &eglImageIn, const DebayerPara
 	glUniform1f(contrastExpUniformDataIn_, params.contrastExp);
 	LOG(Debayer, Debug) << " contrastExpUniformDataIn_ " << contrastExpUniformDataIn_ << " data " << params.contrastExp;
 
+	/* Demosaic: share of Malvar-He-Cutler, the shader may not have it (-1) */
+	glUniform1f(demosaicSharpnessUniformDataIn_, params.demosaicSharpness);
+
 	return;
 }
 
diff --git a/src/libcamera/software_isp/debayer_egl.h b/src/libcamera/software_isp/debayer_egl.h
index d6223f3a9..68d8f4285 100644
--- a/src/libcamera/software_isp/debayer_egl.h
+++ b/src/libcamera/software_isp/debayer_egl.h
@@ -110,6 +110,7 @@ private:
 
 	/* Contrast */
 	GLint contrastExpUniformDataIn_;
+	GLint demosaicSharpnessUniformDataIn_;
 
 	Size nativeOutputSize_;
 	Rectangle window_;
