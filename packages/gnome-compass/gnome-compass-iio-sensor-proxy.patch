 import subprocess
 import time
 
+PROXY_ID = 100
+
+
+class sensor_proxy_compass:
+    '''Heading from iio-sensor-proxy (net.hadess.SensorProxy.Compass).'''
+
+    def __new__(cls):
+        try:
+            from gi.repository import Gio
+            proxy = Gio.DBusProxy.new_for_bus_sync(
+                Gio.BusType.SYSTEM, Gio.DBusProxyFlags.NONE, None,
+                "net.hadess.SensorProxy", "/net/hadess/SensorProxy/Compass",
+                "net.hadess.SensorProxy.Compass", None)
+            has = proxy.get_cached_property("HasCompass")
+            if has is None or not has.unpack():
+                return None
+            proxy.call_sync("ClaimCompass", None, Gio.DBusCallFlags.NONE, 5000, None)
+        except Exception as e:
+            print("* iio-sensor-proxy compass not available:", e)
+            return None
+        self = super().__new__(cls)
+        self.proxy = proxy
+        return self
+
+    def heading(self):
+        # Asked directly each time: the app polls from a worker thread, and
+        # the proxy's property cache is only refreshed by the main loop.
+        from gi.repository import Gio, GLib
+        try:
+            v = self.proxy.call_sync("org.freedesktop.DBus.Properties.Get",
+                                     GLib.Variant("(ss)", ("net.hadess.SensorProxy.Compass",
+                                                           "CompassHeading")),
+                                     Gio.DBusCallFlags.NONE, 1000, None)
+            return v.unpack()[0]
+        except Exception:
+            return 0.0
+
