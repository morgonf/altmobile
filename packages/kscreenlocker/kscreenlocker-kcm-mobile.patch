diff -ruN a/kcm/helper/passwordpolicyhelper.cpp b/kcm/helper/passwordpolicyhelper.cpp
--- a/kcm/helper/passwordpolicyhelper.cpp
+++ b/kcm/helper/passwordpolicyhelper.cpp
@@ -0,0 +1,134 @@
+/*
+SPDX-FileCopyrightText: 2026 morgonf
+
+SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+// Помощник KAuth от root записывает требования к паролю в
+// /etc/passwdqc.conf. Их же применяет passwd (pam_passwdqc) и страница
+// смены PIN-кода. Переписываются только ключи min, max, passphrase,
+// match, similar, enforce; остальные строки файла остаются как есть.
+// Перед записью итог проверяет сам passwdqc.
+
+#include <KAuth/ActionReply>
+#include <KAuth/HelperSupport>
+
+#include <QFile>
+#include <QSaveFile>
+#include <QStringList>
+
+#include <passwdqc.h>
+
+static const QString configPath = QStringLiteral("/etc/passwdqc.conf");
+
+class PasswordPolicyHelper : public QObject
+{
+    Q_OBJECT
+
+public Q_SLOTS:
+    KAuth::ActionReply save(const QVariantMap &args);
+};
+
+static KAuth::ActionReply errorReply(const QString &text)
+{
+    auto reply = KAuth::ActionReply::HelperErrorReply();
+    reply.setErrorDescription(text);
+    return reply;
+}
+
+// Число или «disabled» (-1) для min
+static QString minValue(int value)
+{
+    return value < 0 ? QStringLiteral("disabled") : QString::number(value);
+}
+
+KAuth::ActionReply PasswordPolicyHelper::save(const QVariantMap &args)
+{
+    const QVariantList minList = args.value(QStringLiteral("min")).toList();
+    if (minList.size() != 5) {
+        return errorReply(QStringLiteral("min: нужно пять значений"));
+    }
+    QStringList mins;
+    for (const QVariant &v : minList) {
+        bool ok = false;
+        const int n = v.toInt(&ok);
+        if (!ok || n < -1 || n > 72) {
+            return errorReply(QStringLiteral("min: недопустимое значение"));
+        }
+        mins << minValue(n);
+    }
+    const int max = args.value(QStringLiteral("max")).toInt();
+    const int passphrase = args.value(QStringLiteral("passphrase")).toInt();
+    const int match = args.value(QStringLiteral("match")).toInt();
+    const bool similar = args.value(QStringLiteral("similarDeny")).toBool();
+    const QString enforce = args.value(QStringLiteral("enforce")).toString();
+    if (max < 8 || max > 72 || passphrase < 0 || passphrase > 10 || match < 0 || match > 72
+        || !QStringList{QStringLiteral("none"), QStringLiteral("users"), QStringLiteral("everyone")}.contains(enforce)) {
+        return errorReply(QStringLiteral("недопустимые параметры"));
+    }
+
+    QMap<QString, QString> values{
+        {QStringLiteral("min"), mins.join(QLatin1Char(','))},
+        {QStringLiteral("max"), QString::number(max)},
+        {QStringLiteral("passphrase"), QString::number(passphrase)},
+        {QStringLiteral("match"), QString::number(match)},
+        {QStringLiteral("similar"), similar ? QStringLiteral("deny") : QStringLiteral("permit")},
+        {QStringLiteral("enforce"), enforce},
+    };
+
+    // Проверка самим passwdqc (порядок min, max не меньше min и т. д.)
+    QList<QByteArray> argvData;
+    for (auto it = values.cbegin(); it != values.cend(); ++it) {
+        argvData << (it.key() + QLatin1Char('=') + it.value()).toUtf8();
+    }
+    QList<const char *> argv;
+    for (const QByteArray &a : argvData) {
+        argv << a.constData();
+    }
+    passwdqc_params_t params;
+    passwdqc_params_reset(&params);
+    char *reason = nullptr;
+    if (passwdqc_params_parse(&params, &reason, argv.size(), argv.constData())) {
+        const QString text = QString::fromUtf8(reason ? reason : "неверные параметры");
+        free(reason);
+        passwdqc_params_free(&params);
+        return errorReply(text);
+    }
+    passwdqc_params_free(&params);
+
+    QStringList lines;
+    QFile in(configPath);
+    if (in.open(QIODevice::ReadOnly)) {
+        lines = QString::fromUtf8(in.readAll()).split(QLatin1Char('\n'));
+        if (!lines.isEmpty() && lines.last().isEmpty()) {
+            lines.removeLast();
+        }
+    }
+    QSet<QString> written;
+    for (QString &line : lines) {
+        const QString key = line.section(QLatin1Char('='), 0, 0).trimmed();
+        if (!line.startsWith(QLatin1Char('#')) && values.contains(key)) {
+            line = key + QLatin1Char('=') + values.value(key);
+            written << key;
+        }
+    }
+    for (auto it = values.cbegin(); it != values.cend(); ++it) {
+        if (!written.contains(it.key())) {
+            lines << it.key() + QLatin1Char('=') + it.value();
+        }
+    }
+
+    QSaveFile out(configPath);
+    if (!out.open(QIODevice::WriteOnly) || out.write((lines.join(QLatin1Char('\n')) + QLatin1Char('\n')).toUtf8()) < 0) {
+        return errorReply(out.errorString());
+    }
+    out.setPermissions(QFileDevice::ReadOwner | QFileDevice::WriteOwner | QFileDevice::ReadGroup | QFileDevice::ReadOther);
+    if (!out.commit()) {
+        return errorReply(out.errorString());
+    }
+    return KAuth::ActionReply::SuccessReply();
+}
+
+KAUTH_HELPER_MAIN("org.altmobile.passwordpolicy", PasswordPolicyHelper)
+
+#include "passwordpolicyhelper.moc"
