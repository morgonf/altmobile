@@ -0,0 +1,35 @@
+/*
+SPDX-FileCopyrightText: 2026 morgonf
+
+SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#pragma once
+
+#include <QObject>
+
+// Смена PIN-кода (пароля пользователя) для ALT Mobile. Текущий код
+// проверяет kcheckpass, как на экране блокировки, новый записывает
+// AccountsService (SetPassword), как модуль «Пользователи».
+class PinManager : public QObject
+{
+    Q_OBJECT
+    Q_PROPERTY(bool busy READ busy NOTIFY busyChanged)
+
+public:
+    explicit PinManager(QObject *parent = nullptr);
+
+    bool busy() const;
+    Q_INVOKABLE void changePin(const QString &current, const QString &pin);
+
+Q_SIGNALS:
+    void busyChanged();
+    void succeeded();
+    // wrongPin: текущий код неверен, иначе message с причиной
+    void failed(bool wrongPin, const QString &message);
+
+private:
+    void setBusy(bool busy);
+    void setPassword(const QByteArray &hash, const QString &current);
+
+    bool m_busy = false;
+};
diff -ruN a/kcm/ui/ChangePin.qml b/kcm/ui/ChangePin.qml
--- a/kcm/ui/ChangePin.qml
+++ b/kcm/ui/ChangePin.qml
@@ -0,0 +1,206 @@
+/*
+SPDX-FileCopyrightText: 2026 morgonf
+
+SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+
+import org.kde.kirigami as Kirigami
+
+// ALT Mobile: смена PIN-кода. Три шага на одной цифровой панели (текущий
+// код, новый, повтор), как окно разблокировки SIM. Системная клавиатура не
+// открывается. Текущий код проверяет kcheckpass, новый записывает
+// AccountsService (kcm.pin, pinmanager.cpp).
+Kirigami.Page {
+    id: page
+
+    title: "Сменить PIN-код"
+    padding: Kirigami.Units.gridUnit
+
+    // 0 текущий код, 1 новый, 2 повтор, 3 готово
+    property int step: 0
+    property string current: ""
+    property string fresh: ""
+    property string entry: ""
+    property string error: ""
+
+    readonly property int minLength: 4
+    readonly property int maxLength: 16
+    readonly property bool busy: kcm.pin.busy
+    readonly property bool entryValid: step === 0 ? entry.length > 0 : entry.length >= minLength
+
+    function press(digit) {
+        if (busy || step === 3 || entry.length >= maxLength) {
+            return;
+        }
+        error = "";
+        entry += digit;
+    }
+
+    function erase() {
+        if (!busy && step !== 3) {
+            entry = entry.slice(0, -1);
+        }
+    }
+
+    function submit() {
+        if (busy || !entryValid) {
+            return;
+        }
+        if (step === 0) {
+            current = entry;
+            step = 1;
+        } else if (step === 1) {
+            fresh = entry;
+            step = 2;
+        } else if (step === 2) {
+            if (entry !== fresh) {
+                fresh = "";
+                step = 1;
+                error = "PIN-коды не совпадают, введите новый ещё раз";
+            } else {
+                kcm.pin.changePin(current, fresh);
+            }
+        }
+        entry = "";
+    }
+
+    Connections {
+        target: kcm.pin
+
+        function onSucceeded() {
+            page.current = "";
+            page.fresh = "";
+            page.step = 3;
+            closeTimer.start();
+        }
+
+        function onFailed(wrongPin, message) {
+            page.fresh = "";
+            if (wrongPin) {
+                page.current = "";
+                page.step = 0;
+                page.error = "Неверный текущий PIN-код";
+            } else {
+                page.step = 1;
+                page.error = "Не удалось сменить PIN-код (" + message + ")";
+            }
+        }
+    }
+
+    Timer {
+        id: closeTimer
+        interval: 1500
+        onTriggered: kcm.pop()
+    }
+
+    // Физическая клавиатура, если подключена
+    focus: true
+    Keys.onPressed: event => {
+        if (event.text.length === 1 && event.text >= "0" && event.text <= "9") {
+            page.press(event.text);
+        } else if (event.key === Qt.Key_Backspace) {
+            page.erase();
+        } else if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) {
+            page.submit();
+        } else {
+            return;
+        }
+        event.accepted = true;
+    }
+
+    ColumnLayout {
+        anchors.fill: parent
+        spacing: Kirigami.Units.largeSpacing
+
+        Item { Layout.fillHeight: true }
+
+        Kirigami.Icon {
+            Layout.alignment: Qt.AlignHCenter
+            implicitWidth: Kirigami.Units.iconSizes.large
+            implicitHeight: Kirigami.Units.iconSizes.large
+            source: page.step === 3 ? "dialog-ok" : "lock-symbolic"
+        }
+
+        Kirigami.Heading {
+            Layout.fillWidth: true
+            horizontalAlignment: Text.AlignHCenter
+            wrapMode: Text.WordWrap
+            level: 2
+            text: page.step === 0 ? "Текущий PIN-код"
+                : page.step === 1 ? "Новый PIN-код"
+                : page.step === 2 ? "Повторите новый PIN-код"
+                : "PIN-код изменён"
+        }
+
+        QQC2.Label {
+            Layout.fillWidth: true
+            horizontalAlignment: Text.AlignHCenter
+            wrapMode: Text.WordWrap
+            color: page.error ? Kirigami.Theme.negativeTextColor : Kirigami.Theme.disabledTextColor
+            text: page.busy ? "Проверка…"
+                : page.error ? page.error
+                : page.step === 1 ? "От " + page.minLength + " до " + page.maxLength + " цифр"
+                : ""
+        }
+
+        // Кружки вместо введённых цифр
+        Row {
+            Layout.alignment: Qt.AlignHCenter
+            Layout.preferredHeight: Kirigami.Units.gridUnit * 1.5
+            spacing: Kirigami.Units.largeSpacing
+            visible: page.step !== 3
+            Repeater {
+                model: page.entry.length
+                Rectangle {
+                    anchors.verticalCenter: parent.verticalCenter
+                    width: Kirigami.Units.gridUnit * 0.7
+                    height: width
+                    radius: width / 2
+                    color: Kirigami.Theme.textColor
+                }
+            }
+        }
+
+        Item { Layout.preferredHeight: Kirigami.Units.largeSpacing }
+
+        GridLayout {
+            Layout.alignment: Qt.AlignHCenter
+            columns: 3
+            rowSpacing: Kirigami.Units.largeSpacing
+            columnSpacing: Kirigami.Units.gridUnit * 1.5
+            visible: page.step !== 3
+
+            Repeater {
+                model: ["1", "2", "3", "4", "5", "6", "7", "8", "9", "erase", "0", "ok"]
+                delegate: QQC2.RoundButton {
+                    required property string modelData
+                    readonly property bool digit: modelData.length === 1
+
+                    Layout.preferredWidth: Kirigami.Units.gridUnit * 4
+                    Layout.preferredHeight: Kirigami.Units.gridUnit * 4
+                    focusPolicy: Qt.NoFocus
+                    flat: !digit
+                    text: digit ? modelData : ""
+                    font.pointSize: Kirigami.Theme.defaultFont.pointSize * 1.8
+                    icon.name: modelData === "erase" ? "edit-clear"
+                             : modelData === "ok" ? "dialog-ok-apply" : ""
+                    icon.width: Kirigami.Units.iconSizes.medium
+                    icon.height: Kirigami.Units.iconSizes.medium
+                    enabled: !page.busy && (modelData === "ok" ? page.entryValid
+                                           : modelData === "erase" ? page.entry.length > 0 : true)
+                    highlighted: modelData === "ok" && page.entryValid
+                    onClicked: modelData === "erase" ? page.erase()
+                             : modelData === "ok" ? page.submit()
+                             : page.press(modelData)
+                    onPressAndHold: if (modelData === "erase") page.entry = ""
+                }
+            }
+        }
+
+        Item { Layout.fillHeight: true }
+    }
+}
