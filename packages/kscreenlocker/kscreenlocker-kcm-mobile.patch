+/*
+SPDX-FileCopyrightText: 2026 morgonf
+
+SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#pragma once
+
+#include <QObject>
+#include <QVariantMap>
+
+#include <functional>
+
+// Смена PIN-кода (пароля пользователя) для ALT Mobile. Текущий код
+// проверяет kcheckpass, как на экране блокировки, новый записывает
+// AccountsService (SetPassword), как модуль «Пользователи».
+class PinManager : public QObject
+{
+    Q_OBJECT
+    Q_PROPERTY(bool busy READ busy NOTIFY busyChanged)
+
+public:
+    explicit PinManager(QObject *parent = nullptr);
+
+    bool busy() const;
+    Q_INVOKABLE void changePin(const QString &current, const QString &pin);
+    // Записать требования к паролю (помощник KAuth) после проверки PIN-кода
+    Q_INVOKABLE void savePolicy(const QString &current, const QVariantMap &policy);
+
+Q_SIGNALS:
+    void busyChanged();
+    void succeeded();
+    // wrongPin: текущий код неверен, иначе message с причиной
+    void failed(bool wrongPin, const QString &message);
+
+private:
+    void setBusy(bool busy);
+    void setPassword(const QByteArray &hash, const QString &current);
+    void runPolicyHelper(const QString &current, const QVariantMap &policy);
+    // Проверка PIN в отдельном потоке, затем next в основном
+    void verifyThen(const QString &current, std::function<void()> next);
+
+    bool m_busy = false;
+};
