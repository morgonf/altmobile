diff -ruN a/kcm/passwordpolicy.cpp b/kcm/passwordpolicy.cpp
--- a/kcm/passwordpolicy.cpp
+++ b/kcm/passwordpolicy.cpp
@@ -0,0 +1,121 @@
+/*
+SPDX-FileCopyrightText: 2026 morgonf
+
+SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "passwordpolicy.h"
+
+#include <QHash>
+
+#include <climits>
+#include <passwdqc.h>
+#include <pwd.h>
+#include <unistd.h>
+
+static const char configPath[] = "/etc/passwdqc.conf";
+
+PasswordPolicy::PasswordPolicy(QObject *parent)
+    : QObject(parent)
+{
+    load();
+}
+
+void PasswordPolicy::load()
+{
+    passwdqc_params_t params;
+    passwdqc_params_reset(&params);
+    char *reason = nullptr;
+    if (passwdqc_params_load(&params, &reason, configPath) == 0) {
+        m_min.clear();
+        for (int n : params.qc.min) {
+            m_min << (n == INT_MAX ? -1 : n);
+        }
+        m_max = params.qc.max;
+        m_passphrase = params.qc.passphrase_words;
+        m_match = params.qc.match_length;
+        m_similarDeny = params.qc.similar_deny;
+        switch (params.pam.flags & F_ENFORCE_MASK) {
+        case 0:
+            m_enforce = QStringLiteral("none");
+            break;
+        case F_ENFORCE_EVERYONE:
+            m_enforce = QStringLiteral("everyone");
+            break;
+        default:
+            m_enforce = QStringLiteral("users");
+        }
+    }
+    free(reason);
+    passwdqc_params_free(&params);
+    Q_EMIT changed();
+}
+
+QVariantList PasswordPolicy::min() const
+{
+    return m_min;
+}
+
+int PasswordPolicy::max() const
+{
+    return m_max;
+}
+
+int PasswordPolicy::passphrase() const
+{
+    return m_passphrase;
+}
+
+int PasswordPolicy::match() const
+{
+    return m_match;
+}
+
+bool PasswordPolicy::similarDeny() const
+{
+    return m_similarDeny;
+}
+
+QString PasswordPolicy::enforce() const
+{
+    return m_enforce;
+}
+
+QString PasswordPolicy::check(const QString &newPin, const QString &oldPin) const
+{
+    passwdqc_params_t params;
+    passwdqc_params_reset(&params);
+    char *loadReason = nullptr;
+    if (passwdqc_params_load(&params, &loadReason, configPath)) {
+        free(loadReason);
+        passwdqc_params_free(&params);
+        return QString();
+    }
+    const QByteArray newUtf8 = newPin.toUtf8();
+    const QByteArray oldUtf8 = oldPin.toUtf8();
+    const char *reason = passwdqc_check(&params.qc, newUtf8.constData(), oldUtf8.isEmpty() ? nullptr : oldUtf8.constData(), getpwuid(getuid()));
+    passwdqc_params_free(&params);
+    if (!reason) {
+        return QString();
+    }
+
+    // Причины из passwdqc_check.c
+    static const QHash<QString, QString> russian{
+        {QStringLiteral("is the same as the old one"), QStringLiteral("совпадает с прежним")},
+        {QStringLiteral("is based on the old one"), QStringLiteral("слишком похож на прежний")},
+        {QStringLiteral("too short"), QStringLiteral("слишком короткий")},
+        {QStringLiteral("too long"), QStringLiteral("слишком длинный")},
+        {QStringLiteral("not enough different characters or classes for this length"),
+         QStringLiteral("при такой длине нужно больше разных символов")},
+        {QStringLiteral("not enough different characters or classes"), QStringLiteral("слишком мало разных символов")},
+        {QStringLiteral("based on personal login information"), QStringLiteral("основан на имени пользователя")},
+        {QStringLiteral("based on a dictionary word and not a passphrase"), QStringLiteral("основан на слове из словаря")},
+        {QStringLiteral("based on a common sequence of characters and not a passphrase"),
+         QStringLiteral("основан на простой последовательности (1234, qwerty)")},
+        {QStringLiteral("based on a word list entry"), QStringLiteral("есть в списке слабых паролей")},
+        {QStringLiteral("is in deny list"), QStringLiteral("есть в списке запрещённых")},
+    };
+    const QString english = QString::fromUtf8(reason);
+    return russian.value(english, english);
+}
+
+#include "moc_passwordpolicy.cpp"
