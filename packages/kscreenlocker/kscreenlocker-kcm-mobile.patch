diff -ruN a/kcm/ui/ChangePin.qml b/kcm/ui/ChangePin.qml
--- a/kcm/ui/ChangePin.qml
+++ b/kcm/ui/ChangePin.qml
@@ -0,0 +1,298 @@
+/*
+SPDX-FileCopyrightText: 2026 morgonf
+
+SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+
+import org.kde.kirigami as Kirigami
+
+// ALT Mobile: ввод PIN-кода с цифровой панелью, как окно разблокировки SIM.
+// Режим change меняет код в три шага (текущий, новый, повтор), новый код
+// проверяется требованиями passwdqc (kcm.policy). Режим policy один раз
+// спрашивает PIN-код и сохраняет требования (kcm.pin.savePolicy). Кнопка
+// «АБВ» переключает на ввод пароля с буквами системной клавиатурой.
+Kirigami.Page {
+    id: page
+
+    // change или policy
+    property string mode: "change"
+    // Для режима policy: требования и что вызвать после записи
+    property var policy: ({})
+    property var doneCallback: null
+
+    title: mode === "policy" ? "Подтверждение" : "Сменить PIN-код"
+    padding: Kirigami.Units.gridUnit
+
+    // 0 текущий код, 1 новый, 2 повтор, 3 готово
+    property int step: 0
+    property string current: ""
+    property string fresh: ""
+    property string entry: ""
+    property string error: ""
+    // Предупреждение о слабом коде при enforce=none: второе нажатие принимает
+    property string warnedFor: ""
+    property bool textMode: false
+
+    readonly property var minList: kcm.policy.min
+    // PIN из одних цифр разрешён, если min[0] задан
+    readonly property bool digitsAllowed: minList.length === 0 || minList[0] >= 0
+    readonly property int minLength: digitsAllowed && minList.length > 0 ? minList[0] : 4
+    readonly property int maxLength: kcm.policy.max
+    readonly property bool busy: kcm.pin.busy
+    readonly property bool entryValid: step === 0 ? entry.length > 0 : entry.length > 0 && entry.length <= maxLength
+
+    Component.onCompleted: {
+        kcm.policy.load();
+        textMode = false;
+    }
+
+    function press(digit) {
+        if (busy || step === 3 || entry.length >= maxLength) {
+            return;
+        }
+        error = "";
+        entry += digit;
+    }
+
+    function erase() {
+        if (!busy && step !== 3) {
+            entry = entry.slice(0, -1);
+        }
+    }
+
+    function clearEntry() {
+        entry = "";
+        textField.text = "";
+    }
+
+    function submit() {
+        if (busy || !entryValid) {
+            return;
+        }
+        if (step === 0) {
+            current = entry;
+            if (mode === "policy") {
+                kcm.pin.savePolicy(current, policy);
+            } else {
+                step = 1;
+                // Цифровой PIN запрещён требованиями, сразу буквы
+                textMode = !digitsAllowed;
+                error = digitsAllowed ? "" : "Требования не разрешают PIN-код из одних цифр, нужен пароль с буквами";
+            }
+        } else if (step === 1) {
+            const reason = kcm.policy.check(entry, current);
+            if (reason && kcm.policy.enforce !== "none") {
+                error = "Не подходит, " + reason;
+            } else if (reason && warnedFor !== entry) {
+                warnedFor = entry;
+                error = "Слабый код, " + reason + ". Нажмите ещё раз, чтобы оставить его";
+                return;
+            } else {
+                fresh = entry;
+                step = 2;
+                error = "";
+            }
+        } else if (step === 2) {
+            if (entry !== fresh) {
+                fresh = "";
+                step = 1;
+                error = "Коды не совпадают, введите новый ещё раз";
+            } else {
+                kcm.pin.changePin(current, fresh);
+            }
+        }
+        clearEntry();
+    }
+
+    Connections {
+        target: kcm.pin
+
+        function onSucceeded() {
+            page.current = "";
+            page.fresh = "";
+            page.step = 3;
+            if (page.doneCallback) {
+                page.doneCallback();
+            }
+            closeTimer.start();
+        }
+
+        function onFailed(wrongPin, message) {
+            page.fresh = "";
+            if (wrongPin) {
+                page.current = "";
+                page.step = 0;
+                page.error = "Неверный PIN-код";
+            } else if (page.mode === "policy") {
+                page.step = 0;
+                page.error = "Не удалось сохранить (" + message + ")";
+            } else {
+                page.step = 1;
+                page.error = "Не удалось сменить PIN-код (" + message + ")";
+            }
+        }
+    }
+
+    Timer {
+        id: closeTimer
+        interval: 1500
+        onTriggered: kcm.pop()
+    }
+
+    // Физическая клавиатура, если подключена
+    focus: !page.textMode
+    Keys.onPressed: event => {
+        if (event.text.length === 1 && event.text >= "0" && event.text <= "9") {
+            page.press(event.text);
+        } else if (event.key === Qt.Key_Backspace) {
+            page.erase();
+        } else if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) {
+            page.submit();
+        } else {
+            return;
+        }
+        event.accepted = true;
+    }
+
+    ColumnLayout {
+        anchors.fill: parent
+        spacing: Kirigami.Units.largeSpacing
+
+        Item { Layout.fillHeight: true }
+
+        Kirigami.Icon {
+            Layout.alignment: Qt.AlignHCenter
+            implicitWidth: Kirigami.Units.iconSizes.large
+            implicitHeight: Kirigami.Units.iconSizes.large
+            source: page.step === 3 ? "dialog-ok" : "lock-symbolic"
+        }
+
+        Kirigami.Heading {
+            Layout.fillWidth: true
+            horizontalAlignment: Text.AlignHCenter
+            wrapMode: Text.WordWrap
+            level: 2
+            text: page.step === 3 ? (page.mode === "policy" ? "Требования сохранены" : "PIN-код изменён")
+                : page.step === 0 ? (page.mode === "policy" ? "Введите PIN-код" : "Текущий PIN-код")
+                : page.step === 1 ? "Новый код"
+                : "Повторите новый код"
+        }
+
+        QQC2.Label {
+            Layout.fillWidth: true
+            horizontalAlignment: Text.AlignHCenter
+            wrapMode: Text.WordWrap
+            color: page.error ? Kirigami.Theme.negativeTextColor : Kirigami.Theme.disabledTextColor
+            text: page.busy ? "Проверка…"
+                : page.error ? page.error
+                : page.step === 1 && page.digitsAllowed ? "PIN-код не короче " + page.minLength + " цифр"
+                : ""
+        }
+
+        // Кружки вместо введённых цифр
+        Row {
+            Layout.alignment: Qt.AlignHCenter
+            Layout.preferredHeight: Kirigami.Units.gridUnit * 1.5
+            spacing: Kirigami.Units.largeSpacing
+            visible: page.step !== 3 && !page.textMode
+            Repeater {
+                model: page.entry.length
+                Rectangle {
+                    anchors.verticalCenter: parent.verticalCenter
+                    width: Kirigami.Units.gridUnit * 0.7
+                    height: width
+                    radius: width / 2
+                    color: Kirigami.Theme.textColor
+                }
+            }
+        }
+
+        // Пароль с буквами
+        Kirigami.PasswordField {
+            id: textField
+            Layout.alignment: Qt.AlignHCenter
+            Layout.preferredWidth: Kirigami.Units.gridUnit * 16
+            visible: page.step !== 3 && page.textMode
+            enabled: !page.busy
+            maximumLength: page.maxLength
+            onTextChanged: {
+                page.entry = text;
+                if (text) {
+                    page.error = "";
+                }
+            }
+            onAccepted: page.submit()
+        }
+
+        Item { Layout.preferredHeight: Kirigami.Units.largeSpacing }
+
+        GridLayout {
+            Layout.alignment: Qt.AlignHCenter
+            columns: 3
+            rowSpacing: Kirigami.Units.largeSpacing
+            columnSpacing: Kirigami.Units.gridUnit * 1.5
+            visible: page.step !== 3 && !page.textMode
+
+            Repeater {
+                model: ["1", "2", "3", "4", "5", "6", "7", "8", "9", "erase", "0", "ok"]
+                delegate: QQC2.RoundButton {
+                    required property string modelData
+                    readonly property bool digit: modelData.length === 1
+
+                    Layout.preferredWidth: Kirigami.Units.gridUnit * 4
+                    Layout.preferredHeight: Kirigami.Units.gridUnit * 4
+                    focusPolicy: Qt.NoFocus
+                    flat: !digit
+                    text: digit ? modelData : ""
+                    font.pointSize: Kirigami.Theme.defaultFont.pointSize * 1.8
+                    icon.name: modelData === "erase" ? "edit-clear"
+                             : modelData === "ok" ? "dialog-ok-apply" : ""
+                    icon.width: Kirigami.Units.iconSizes.medium
+                    icon.height: Kirigami.Units.iconSizes.medium
+                    enabled: !page.busy && (modelData === "ok" ? page.entryValid
+                                           : modelData === "erase" ? page.entry.length > 0 : true)
+                    highlighted: modelData === "ok" && page.entryValid
+                    onClicked: modelData === "erase" ? page.erase()
+                             : modelData === "ok" ? page.submit()
+                             : page.press(modelData)
+                    onPressAndHold: if (modelData === "erase") page.entry = ""
+                }
+            }
+        }
+
+        RowLayout {
+            Layout.alignment: Qt.AlignHCenter
+            visible: page.step !== 3
+            spacing: Kirigami.Units.largeSpacing
+
+            QQC2.Button {
+                flat: true
+                text: page.textMode ? "123" : "АБВ"
+                // На новом коде без разрешения цифр вернуться к цифрам нельзя
+                enabled: !page.busy && (page.textMode ? (page.step === 0 || page.digitsAllowed) : true)
+                onClicked: {
+                    page.textMode = !page.textMode;
+                    page.clearEntry();
+                    if (page.textMode) {
+                        textField.forceActiveFocus();
+                    } else {
+                        page.forceActiveFocus();
+                    }
+                }
+            }
+
+            QQC2.Button {
+                visible: page.textMode
+                text: "Готово"
+                enabled: page.entryValid && !page.busy
+                onClicked: page.submit()
+            }
+        }
+
+        Item { Layout.fillHeight: true }
+    }
+}
