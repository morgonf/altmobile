--- a/kcm/passwordpolicy.h
+++ b/kcm/passwordpolicy.h
@@ -0,0 +1,51 @@
+/*
+SPDX-FileCopyrightText: 2026 morgonf
+
+SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#pragma once
+
+#include <QObject>
+#include <QVariantList>
+
+// Требования к паролю из /etc/passwdqc.conf (их же применяет passwd).
+// Чтение и проверка нового кода библиотекой passwdqc. Запись идёт через
+// помощника KAuth (PinManager::savePolicy).
+class PasswordPolicy : public QObject
+{
+    Q_OBJECT
+    // Наименьшая длина по числу видов символов: один, два, кодовая фраза,
+    // три, четыре. -1 означает «запрещено»
+    Q_PROPERTY(QVariantList min READ min NOTIFY changed)
+    Q_PROPERTY(int max READ max NOTIFY changed)
+    Q_PROPERTY(int passphrase READ passphrase NOTIFY changed)
+    Q_PROPERTY(int match READ match NOTIFY changed)
+    Q_PROPERTY(bool similarDeny READ similarDeny NOTIFY changed)
+    // none, users или everyone
+    Q_PROPERTY(QString enforce READ enforce NOTIFY changed)
+
+public:
+    explicit PasswordPolicy(QObject *parent = nullptr);
+
+    QVariantList min() const;
+    int max() const;
+    int passphrase() const;
+    int match() const;
+    bool similarDeny() const;
+    QString enforce() const;
+
+    Q_INVOKABLE void load();
+    // Пустая строка, если код подходит, иначе причина по-русски
+    Q_INVOKABLE QString check(const QString &newPin, const QString &oldPin) const;
+
+Q_SIGNALS:
+    void changed();
+
+private:
+    QVariantList m_min;
+    int m_max = 72;
+    int m_passphrase = 3;
+    int m_match = 4;
+    bool m_similarDeny = true;
+    QString m_enforce = QStringLiteral("users");
+};
