--- a/kcm/pinagent.h
+++ b/kcm/pinagent.h
@@ -0,0 +1,42 @@
+/*
+SPDX-FileCopyrightText: 2026 morgonf
+
+SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#pragma once
+
+#include <PolkitQt1/Agent/Listener>
+#include <PolkitQt1/Agent/Session>
+
+// Агент polkit только для процесса настроек и только на время смены PIN
+// или записи требований к паролю.
+// AccountsService спрашивает у polkit право change-own-password (auth_self),
+// и без своего агента системный агент открывал окно «Требуется
+// аутентификация», хотя текущий PIN пользователь уже ввёл. Агент отвечает
+// polkit этим кодом. Пароль по-прежнему проверяет polkit (PAM), правила
+// polkit не ослабляются.
+class PinAgent : public PolkitQt1::Agent::Listener
+{
+    Q_OBJECT
+
+public:
+    PinAgent(const QString &password, const QString &actionId, QObject *parent = nullptr);
+
+    bool registerForThisProcess();
+
+public Q_SLOTS:
+    void initiateAuthentication(const QString &actionId,
+                                const QString &message,
+                                const QString &iconName,
+                                const PolkitQt1::Details &details,
+                                const QString &cookie,
+                                const PolkitQt1::Identity::List &identities,
+                                PolkitQt1::Agent::AsyncResult *result) override;
+    bool initiateAuthenticationFinish() override;
+    void cancelAuthentication() override;
+
+private:
+    QString m_password;
+    QString m_actionId;
+    PolkitQt1::Agent::Session *m_session = nullptr;
+};
