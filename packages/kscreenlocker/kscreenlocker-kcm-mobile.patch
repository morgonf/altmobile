+#include "pinmanager.h"
+#include "pinagent.h"
+
+#include <QCoreApplication>
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QDBusObjectPath>
+#include <QDBusPendingCallWatcher>
+#include <QDBusPendingReply>
+#include <QPointer>
+#include <QThread>
+
+#include <KAuth/Action>
+#include <KAuth/ExecuteJob>
+
+#include <crypt.h>
+#include <errno.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/socket.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+namespace
+{
+// Коды протокола kcheckpass (kcheckpass-enums.h из пакета ALT)
+enum {
+    ConvGetNormal,
+    ConvGetHidden,
+    ConvPutInfo,
+    ConvPutError,
+    ConvPutAuthSucceeded,
+    ConvPutAuthFailed,
+};
+
+enum CheckResult {
+    CheckOk,
+    CheckBad,
+    CheckError,
+};
+
+bool readAll(int fd, void *buf, size_t len)
+{
+    auto p = static_cast<char *>(buf);
+    while (len) {
+        const ssize_t n = ::read(fd, p, len);
+        if (n < 0 && errno == EINTR) {
+            continue;
+        }
+        if (n <= 0) {
+            return false;
+        }
+        p += n;
+        len -= n;
+    }
+    return true;
+}
+
+bool writeAll(int fd, const void *buf, size_t len)
+{
+    auto p = static_cast<const char *>(buf);
+    while (len) {
+        const ssize_t n = ::write(fd, p, len);
+        if (n < 0 && errno == EINTR) {
+            continue;
+        }
+        if (n <= 0) {
+            return false;
+        }
+        p += n;
+        len -= n;
+    }
+    return true;
+}
+
+bool sendInt(int fd, int value)
+{
+    return writeAll(fd, &value, sizeof(value));
+}
+
+bool sendStr(int fd, const QByteArray &str)
+{
+    // Длина вместе с нулём в конце, как GSendStr в греетере
+    const int len = str.size() + 1;
+    return sendInt(fd, len) && writeAll(fd, str.constData(), len);
+}
+
+bool recvStr(int fd)
+{
+    int len;
+    if (!readAll(fd, &len, sizeof(len)) || len < 0 || len > 0x10000) {
+        return false;
+    }
+    QByteArray buf(len, Qt::Uninitialized);
+    return readAll(fd, buf.data(), len);
+}
+
+// Проверка пароля через kcheckpass (setgid chkpwd), службой PAM kde,
+// той же, что у экрана блокировки. Сам процесс настроек файл tcb
+// прочитать не может.
+CheckResult checkPassword(const QByteArray &password)
+{
+    int sv[2];
+    if (::socketpair(AF_LOCAL, SOCK_STREAM | SOCK_CLOEXEC, 0, sv)) {
+        return CheckError;
+    }
+    // SIGUSR1 блокируется до fork и остаётся заблокированным в kcheckpass:
+    // тот включает signalfd не сразу, а незаблокированный SIGUSR1 убил бы
+    // его. Заблокированный дождётся в очереди. Блокировать в самом ребёнке
+    // поздно, kill из родителя может успеть раньше.
+    sigset_t mask, oldMask;
+    sigemptyset(&mask);
+    sigaddset(&mask, SIGUSR1);
+    sigaddset(&mask, SIGUSR2);
+    pthread_sigmask(SIG_BLOCK, &mask, &oldMask);
+    const pid_t pid = ::fork();
+    if (pid != 0) {
+        pthread_sigmask(SIG_SETMASK, &oldMask, nullptr);
+    }
+    if (pid < 0) {
+        ::close(sv[0]);
+        ::close(sv[1]);
+        return CheckError;
+    }
+    if (pid == 0) {
+        ::close(sv[0]);
+        const int fd = ::dup(sv[1]); // без CLOEXEC
+        char arg[16];
+        snprintf(arg, sizeof(arg), "%d", fd);
+        execl("/usr/libexec/kcheckpass", "kcheckpass", "-S", arg, static_cast<char *>(nullptr));
+        _exit(20);
+    }
+    ::close(sv[1]);
+    const int fd = sv[0];
+
+    CheckResult result = CheckError;
+    if (sendStr(fd, QByteArrayLiteral("kde"))) {
+        ::kill(pid, SIGUSR1);
+        int prompts = 0;
+        int what;
+        while (readAll(fd, &what, sizeof(what))) {
+            if (what == ConvGetNormal || what == ConvGetHidden) {
+                if (!recvStr(fd) || ++prompts > 3 || !sendInt(fd, 0) || !sendStr(fd, password)) {
+                    break;
+                }
+            } else if (what == ConvPutInfo || what == ConvPutError) {
+                if (!recvStr(fd)) {
+                    break;
+                }
+            } else {
+                if (what == ConvPutAuthSucceeded) {
+                    result = CheckOk;
+                } else if (what == ConvPutAuthFailed) {
+                    result = CheckBad;
+                }
+                break;
+            }
+        }
+    }
+    ::kill(pid, SIGUSR2);
+    ::close(fd);
+    while (::waitpid(pid, nullptr, 0) < 0 && errno == EINTR) { }
+    return result;
+}
+
+// Хеш gost-yescrypt, как у модуля «Пользователи» в ALT, запасной yescrypt
+QByteArray hashPin(const QByteArray &pin)
+{
+    for (const char *prefix : {"$gy$", "$y$"}) {
+        char *setting = crypt_gensalt_ra(prefix, 0, nullptr, 0);
+        if (!setting) {
+            continue;
+        }
+        void *data = nullptr;
+        int size = 0;
+        const char *hash = crypt_ra(pin.constData(), setting, &data, &size);
+        QByteArray result;
+        if (hash && hash[0] != '*') {
+            result = hash;
+        }
+        free(data);
+        free(setting);
+        if (!result.isEmpty()) {
+            return result;
+        }
+    }
+    return {};
+}
+}
+
+PinManager::PinManager(QObject *parent)
+    : QObject(parent)
+{
+}
+
+bool PinManager::busy() const
+{
+    return m_busy;
+}
+
+void PinManager::setBusy(bool busy)
+{
+    if (m_busy != busy) {
+        m_busy = busy;
+        Q_EMIT busyChanged();
+    }
+}
+
+void PinManager::changePin(const QString &current, const QString &pin)
+{
+    if (m_busy) {
+        return;
+    }
+    setBusy(true);
+    QPointer<PinManager> self(this);
+    const QByteArray currentUtf8 = current.toUtf8();
+    const QByteArray pinUtf8 = pin.toUtf8();
+    // kcheckpass и хеш занимают до секунды, интерфейс не держим
+    QThread *thread = QThread::create([self, currentUtf8, pinUtf8]() {
+        const CheckResult check = checkPassword(currentUtf8);
+        const QByteArray hash = check == CheckOk ? hashPin(pinUtf8) : QByteArray();
+        QMetaObject::invokeMethod(qApp, [self, check, hash, currentUtf8]() {
+            if (!self) {
+                return;
+            }
+            if (check == CheckBad) {
+                self->setBusy(false);
+                Q_EMIT self->failed(true, QString());
+            } else if (check != CheckOk) {
+                self->setBusy(false);
+                Q_EMIT self->failed(false, QStringLiteral("не удалось проверить текущий PIN-код"));
+            } else if (hash.isEmpty()) {
+                self->setBusy(false);
+                Q_EMIT self->failed(false, QStringLiteral("не удалось зашифровать новый PIN-код"));
+            } else {
+                self->setPassword(hash, QString::fromUtf8(currentUtf8));
+            }
+        });
+    });
+    connect(thread, &QThread::finished, thread, &QObject::deleteLater);
+    thread->start();
+}
+
+void PinManager::setPassword(const QByteArray &hash, const QString &current)
+{
+    const QString service = QStringLiteral("org.freedesktop.Accounts");
+    auto find = QDBusMessage::createMethodCall(service,
+                                               QStringLiteral("/org/freedesktop/Accounts"),
+                                               QStringLiteral("org.freedesktop.Accounts"),
+                                               QStringLiteral("FindUserById"));
+    find << qlonglong(::getuid());
+    const QDBusMessage found = QDBusConnection::systemBus().call(find);
+    const QString path = found.arguments().value(0).value<QDBusObjectPath>().path();
+    if (found.type() != QDBusMessage::ReplyMessage || path.isEmpty()) {
+        setBusy(false);
+        Q_EMIT failed(false, found.errorMessage());
+        return;
+    }
+
+    auto set = QDBusMessage::createMethodCall(service, path, QStringLiteral("org.freedesktop.Accounts.User"), QStringLiteral("SetPassword"));
+    set << QString::fromLatin1(hash) << QString();
+    // polkit спросит пароль (auth_self) у агента этого процесса, тот
+    // ответит уже проверенным текущим PIN-кодом (pinagent.h)
+    auto agent = new PinAgent(current, QStringLiteral("org.freedesktop.accounts.change-own-password"), this);
+    if (!agent->registerForThisProcess()) {
+        qWarning("PinAgent: не удалось зарегистрировать агента polkit");
+    }
+    set.setInteractiveAuthorizationAllowed(true);
+    auto watcher = new QDBusPendingCallWatcher(QDBusConnection::systemBus().asyncCall(set, 120000), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this, agent](QDBusPendingCallWatcher *w) {
+        w->deleteLater();
+        agent->deleteLater();
+        const QDBusPendingReply<> reply = *w;
+        setBusy(false);
+        if (reply.isError()) {
+            Q_EMIT failed(false, reply.error().message());
+        } else {
+            Q_EMIT succeeded();
+        }
+    });
+}
+
+void PinManager::verifyThen(const QString &current, std::function<void()> next)
+{
+    QPointer<PinManager> self(this);
+    const QByteArray currentUtf8 = current.toUtf8();
+    QThread *thread = QThread::create([self, currentUtf8, next]() {
+        const CheckResult check = checkPassword(currentUtf8);
+        QMetaObject::invokeMethod(qApp, [self, check, next]() {
+            if (!self) {
+                return;
+            }
+            if (check == CheckOk) {
+                next();
+                return;
+            }
+            self->setBusy(false);
+            if (check == CheckBad) {
+                Q_EMIT self->failed(true, QString());
+            } else {
+                Q_EMIT self->failed(false, QStringLiteral("не удалось проверить PIN-код"));
+            }
+        });
+    });
+    connect(thread, &QThread::finished, thread, &QObject::deleteLater);
+    thread->start();
+}
+
+void PinManager::savePolicy(const QString &current, const QVariantMap &policy)
+{
+    if (m_busy) {
+        return;
+    }
+    setBusy(true);
+    verifyThen(current, [this, current, policy]() {
+        runPolicyHelper(current, policy);
+    });
+}
+
+void PinManager::runPolicyHelper(const QString &current, const QVariantMap &policy)
+{
+    const QString actionId = QStringLiteral("org.altmobile.passwordpolicy.save");
+    // polkit спросит пароль (auth_self) у агента этого процесса
+    auto agent = new PinAgent(current, actionId, this);
+    if (!agent->registerForThisProcess()) {
+        qWarning("PinAgent: не удалось зарегистрировать агента polkit");
+    }
+    KAuth::Action action(actionId);
+    action.setHelperId(QStringLiteral("org.altmobile.passwordpolicy"));
+    action.setArguments(policy);
+    KAuth::ExecuteJob *job = action.execute();
+    connect(job, &KJob::result, this, [this, job, agent]() {
+        agent->deleteLater();
+        setBusy(false);
+        if (job->error()) {
+            Q_EMIT failed(false, job->errorString().isEmpty() ? job->errorText() : job->errorString());
+        } else {
+            Q_EMIT succeeded();
+        }
+    });
+    job->start();
+}
+
+#include "moc_pinmanager.cpp"
