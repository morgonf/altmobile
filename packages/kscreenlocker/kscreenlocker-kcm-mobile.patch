@@ -0,0 +1,90 @@
+/*
+SPDX-FileCopyrightText: 2026 morgonf
+
+SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "pinagent.h"
+
+#include <QCoreApplication>
+
+#include <memory>
+
+#include <PolkitQt1/Identity>
+#include <PolkitQt1/Subject>
+
+#include <unistd.h>
+
+PinAgent::PinAgent(const QString &password, const QString &actionId, QObject *parent)
+    : PolkitQt1::Agent::Listener(parent)
+    , m_password(password)
+    , m_actionId(actionId)
+{
+}
+
+bool PinAgent::registerForThisProcess()
+{
+    // Агент процесса важнее агента сеанса: polkit спросит его, а не
+    // системное окно
+    return registerListener(PolkitQt1::UnixProcessSubject(QCoreApplication::applicationPid()),
+                            QStringLiteral("/org/altmobile/PinAgent"));
+}
+
+void PinAgent::initiateAuthentication(const QString &actionId,
+                                      const QString &message,
+                                      const QString &iconName,
+                                      const PolkitQt1::Details &details,
+                                      const QString &cookie,
+                                      const PolkitQt1::Identity::List &identities,
+                                      PolkitQt1::Agent::AsyncResult *result)
+{
+    Q_UNUSED(message)
+    Q_UNUSED(iconName)
+    Q_UNUSED(details)
+
+    // Отвечаем только на своё действие и только за себя
+    PolkitQt1::Identity self;
+    // toString() даёт имя (unix-user:altlinux), сравниваем по uid
+    for (PolkitQt1::Identity identity : identities) {
+        const PolkitQt1::UnixUserIdentity user = identity.toUnixUserIdentity();
+        if (user.isValid() && user.uid() == ::getuid()) {
+            self = identity;
+        }
+    }
+    if (m_session || actionId != m_actionId || !self.isValid()) {
+        result->setError(QStringLiteral("не то действие"));
+        result->setCompleted();
+        return;
+    }
+
+    m_session = new PolkitQt1::Agent::Session(self, cookie, result, this);
+    // Код отдаётся один раз за запрос: если PAM спросит снова, код не подошёл
+    auto answered = std::make_shared<bool>(false);
+    connect(m_session, &PolkitQt1::Agent::Session::request, this, [this, answered](const QString &, bool) {
+        if (*answered) {
+            m_session->cancel();
+        } else {
+            *answered = true;
+            m_session->setResponse(m_password);
+        }
+    });
+    connect(m_session, &PolkitQt1::Agent::Session::completed, this, [this](bool) {
+        m_session->result()->setCompleted();
+        m_session->deleteLater();
+        m_session = nullptr;
+    });
+    m_session->initiate();
+}
+
+bool PinAgent::initiateAuthenticationFinish()
+{
+    return true;
+}
+
+void PinAgent::cancelAuthentication()
+{
+    if (m_session) {
+        m_session->cancel();
+    }
+}
+
+#include "moc_pinagent.cpp"
