diff -ruN a/kcm/ui/PasswordPolicy.qml b/kcm/ui/PasswordPolicy.qml
--- a/kcm/ui/PasswordPolicy.qml
+++ b/kcm/ui/PasswordPolicy.qml
@@ -0,0 +1,265 @@
+/*
+SPDX-FileCopyrightText: 2026 morgonf
+
+SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+
+import org.kde.kcmutils as KCM
+import org.kde.kirigami as Kirigami
+import org.kde.kirigamiaddons.formcard 1 as FormCard
+
+// ALT Mobile: требования к PIN-коду и паролю (/etc/passwdqc.conf, их же
+// применяет passwd). Правки копятся на странице, «Сохранить» просит
+// PIN-код (ChangePin.qml в режиме policy) и пишет файл через помощника
+// KAuth. У passwdqc длины min не возрастают слева направо: чем больше
+// видов символов, тем короче может быть код. Верхние пределы полей ниже
+// поэтому зависят от полей выше.
+KCM.SimpleKCM {
+    id: page
+
+    title: "Требования к коду"
+
+    leftPadding: 0
+    rightPadding: 0
+    topPadding: 0
+    bottomPadding: 0
+
+    readonly property var policy: kcm.policy
+
+    property bool pinAllowed
+    property int pinMin
+    property int min2
+    property int min3
+    property int min4
+    property bool phraseAllowed
+    property int phraseMin
+    property int phraseWords
+    property bool dictionary
+    property bool similarDeny
+    property int maxLength
+    property string enforce
+    property bool dirty: false
+
+    function reset() {
+        policy.load();
+        const m = policy.min;
+        pinAllowed = m[0] >= 0;
+        pinMin = m[0] >= 0 ? m[0] : 6;
+        min2 = m[1] >= 0 ? m[1] : 8;
+        phraseMin = m[2] >= 0 ? m[2] : 8;
+        min3 = m[3] >= 0 ? m[3] : 8;
+        min4 = m[4] >= 0 ? m[4] : 8;
+        phraseAllowed = policy.passphrase > 0;
+        phraseWords = policy.passphrase > 0 ? policy.passphrase : 3;
+        dictionary = policy.match > 0;
+        similarDeny = policy.similarDeny;
+        maxLength = policy.max;
+        enforce = policy.enforce;
+        dirty = false;
+    }
+
+    function result() {
+        const n0 = pinAllowed ? pinMin : -1;
+        const n1 = pinAllowed ? Math.min(min2, n0) : min2;
+        const n2 = Math.min(phraseMin, n1);
+        const n3 = Math.min(min3, n2);
+        const n4 = Math.min(min4, n3);
+        return {
+            "min": [n0, n1, n2, n3, n4],
+            "max": Math.max(maxLength, pinAllowed ? n0 : n1),
+            "passphrase": phraseAllowed ? phraseWords : 0,
+            "match": dictionary ? 4 : 0,
+            "similarDeny": similarDeny,
+            "enforce": enforce,
+        };
+    }
+
+    Component.onCompleted: reset()
+
+    readonly property var enforceModel: [
+        { value: "users", text: "Запрещать" },
+        { value: "none", text: "Только предупреждать" },
+        { value: "everyone", text: "Запрещать и для root" },
+    ]
+
+    ColumnLayout {
+        spacing: 0
+
+        FormCard.FormHeader {
+            title: "PIN-код"
+        }
+
+        FormCard.FormCard {
+            FormCard.FormSwitchDelegate {
+                id: pinSwitch
+                text: "Разрешить PIN-код из одних цифр"
+                description: "Иначе нужен пароль с буквами"
+                checked: page.pinAllowed
+                onToggled: { page.pinAllowed = checked; page.dirty = true; }
+            }
+
+            FormCard.FormDelegateSeparator { visible: page.pinAllowed }
+
+            FormCard.FormSpinBoxDelegate {
+                visible: page.pinAllowed
+                label: "Не короче, цифр"
+                from: 4
+                to: 40
+                value: page.pinMin
+                onValueChanged: if (value !== page.pinMin) { page.pinMin = value; page.dirty = true; }
+            }
+        }
+
+        FormCard.FormHeader {
+            title: "Пароль"
+        }
+
+        FormCard.FormCard {
+            FormCard.FormSpinBoxDelegate {
+                label: "Не короче, два вида символов"
+                from: 4
+                to: page.pinAllowed ? page.pinMin : 72
+                value: page.min2
+                onValueChanged: if (value !== page.min2) { page.min2 = value; page.dirty = true; }
+            }
+
+            FormCard.FormDelegateSeparator {}
+
+            FormCard.FormSpinBoxDelegate {
+                label: "Не короче, три вида символов"
+                from: 4
+                to: Math.min(page.min2, page.phraseMin)
+                value: page.min3
+                onValueChanged: if (value !== page.min3) { page.min3 = value; page.dirty = true; }
+            }
+
+            FormCard.FormDelegateSeparator {}
+
+            FormCard.FormSpinBoxDelegate {
