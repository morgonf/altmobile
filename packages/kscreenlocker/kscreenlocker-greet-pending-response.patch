+void KCheckPass::respond(const QByteArray &response)
+{
+    if (m_awaitingResponse) {
+        Q_EMIT promptResponseReceived(response);
+        return;
+    }
+    qCDebug(KSCREENLOCKER_GREET, "[PAM worker %s] Response before the prompt, keeping it", qUtf8Printable(m_service));
+    m_pendingResponse = response;
