@@ -2,6 +2,7 @@
 // SPDX-FileCopyrightText: 2018 Jonah Brüchert <jbb@kaidan.im>
 // SPDX-FileCopyrightText: 2025 Andrew Wang
 // SPDX-FileCopyrightText: 2025 Devin Lin <devin@kde.org>
+// SPDX-FileCopyrightText: 2026 morgonf
