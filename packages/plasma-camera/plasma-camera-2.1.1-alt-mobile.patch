From afa5b57259b6996e85c8e96b859dc532b13e2ef0 Mon Sep 17 00:00:00 2001
From: morgonf <morgonf@altlinux.org>
Date: Mon, 28 Sep 2026 00:53:07 -0400
Subject: [PATCH 1/3] Viewfinder: at most 2400 pixels wide (binned mode on the
 OnePlus 6T)

---
 src/plasmacamera/worker.cpp | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/src/plasmacamera/worker.cpp b/src/plasmacamera/worker.cpp
index 65a6b37..a4c8ea4 100644
--- a/src/plasmacamera/worker.cpp
+++ b/src/plasmacamera/worker.cpp
@@ -465,6 +465,27 @@ void Worker::configure()
     // TODO: allow user to override config
     //  - https://git.libcamera.org/libcamera/libcamera.git/tree/src/apps/qcam/main_window.cpp#n399
 
+    // ALT Mobile: the default is the full sensor (16 MP on the OnePlus 6T).
+    // With the software ISP that gives 11 fps at best, and photos are taken
+    // from this stream, so take the largest size not wider than 2400 pixels
+    // (the 2x2 binned 2328x1748 mode on the IMX519): twice the frame rate
+    // and less noise in the dark.
+    constexpr unsigned int kMaxViewfinderWidth = 2400;
+    if (streamConfig.size.width > kMaxViewfinderWidth) {
+        libcamera::Size best;
+        for (const libcamera::Size &size : streamConfig.formats().sizes(streamConfig.pixelFormat)) {
+            if (size.width <= kMaxViewfinderWidth && size.width * size.height > best.width * best.height) {
+                best = size;
+            }
+        }
+        if (best.isNull()) {
+            // Only a range is advertised: scale down keeping the aspect ratio
+            const unsigned int w = kMaxViewfinderWidth & ~7u;
+            best = libcamera::Size(w, (streamConfig.size.height * w / streamConfig.size.width) & ~1u);
+        }
+        streamConfig.size = best;
+    }
+
     qDebug() << "Viewfinder configuration is: " << streamConfig.toString();
 
     // Validate config
-- 
