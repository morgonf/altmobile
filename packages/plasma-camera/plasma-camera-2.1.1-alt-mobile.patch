+void PlasmaCamera::focusAt(qreal u, qreal v, const bool lock)
+{
+    if (!m_settings.canSetAfWindow() || m_activeArea.isNull()) {
+        return;
+    }
+
+    // Undo the viewfinder transform: mirroring, then the clockwise rotation
+    if (m_mirrorOutput) {
+        u = 1.0 - u;
+    }
+    qreal sx = u, sy = v;
+    switch (m_softwareRotationDegrees) {
+    case 90:
+        sx = v;
+        sy = 1.0 - u;
+        break;
+    case 180:
+        sx = 1.0 - u;
+        sy = 1.0 - v;
+        break;
+    case 270:
+        sx = 1.0 - v;
+        sy = u;
+        break;
+    }
+    sx = std::clamp(sx, 0.0, 1.0);
+    sy = std::clamp(sy, 0.0, 1.0);
+
+    // A window of a fifth of the frame around the point
+    const unsigned int w = m_activeArea.width / 5;
+    const unsigned int h = m_activeArea.height / 5;
+    const int x = std::clamp<int>(m_activeArea.x + static_cast<int>(sx * m_activeArea.width) - static_cast<int>(w / 2),
+                                  m_activeArea.x, m_activeArea.x + static_cast<int>(m_activeArea.width - w));
+    const int y = std::clamp<int>(m_activeArea.y + static_cast<int>(sy * m_activeArea.height) - static_cast<int>(h / 2),
+                                  m_activeArea.y, m_activeArea.y + static_cast<int>(m_activeArea.height - h));
+
+    m_settings.setFocusRegion(libcamera::Rectangle(x, y, w, h), lock);
+    Q_EMIT settingsChanged(m_settings);
+    // The worker got its copy with the trigger; later updates must not resend it
+    m_settings.clearFocusTrigger();
+}
+
+void PlasmaCamera::resetFocus()
+{
+    m_settings.clearFocusRegion();
+    Q_EMIT settingsChanged(m_settings);
+}
+
+bool PlasmaCamera::focusRegionAvailable() const
+{
+    return m_settings.canSetAfWindow();
+}
+
+int PlasmaCamera::afState() const
+{
+    return m_afState;
+}
+
+bool PlasmaCamera::focusLocked() const
+{
+    return m_settings.focusLocked();
+}
+
 void PlasmaCamera::resetExposureValue()
 {
     m_settings.unSetExposureValue();
