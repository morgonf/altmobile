diff --git a/src/plasmacamera/nightmerge.cpp b/src/plasmacamera/nightmerge.cpp
new file mode 100644
index 0000000..1f5808f
--- /dev/null
+++ b/src/plasmacamera/nightmerge.cpp
@@ -0,0 +1,310 @@
+// SPDX-FileCopyrightText: 2026 morgonf
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "nightmerge.h"
+
+#include <QDebug>
+#include <QElapsedTimer>
+#include <QStringList>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <functional>
+#include <thread>
+#include <vector>
+
+namespace
+{
+
+// 8-bit luma plane
+struct Plane {
+    int w = 0;
+    int h = 0;
+    std::vector<uint8_t> px;
+
+    uint8_t at(int x, int y) const
+    {
+        return px[static_cast<size_t>(y) * w + x];
+    }
+};
+
+// Pyramid levels below the full size: 1/2 .. 1/16
+constexpr int kLevels = 5;
+// Search radius at the coarsest level (1/16): +-64 pixels at full size
+constexpr int kCoarseRadius = 4;
+
+void parallelRows(int rows, const std::function<void(int, int)> &fn)
+{
+    const int n = std::clamp(static_cast<int>(std::thread::hardware_concurrency()), 1, 8);
+    const int chunk = (rows + n - 1) / n;
+    std::vector<std::thread> threads;
+    for (int i = 0; i < n; i++) {
+        const int begin = i * chunk;
+        const int end = std::min(rows, begin + chunk);
+        if (begin >= end) {
+            break;
+        }
+        threads.emplace_back(fn, begin, end);
+    }
+    for (std::thread &t : threads) {
+        t.join();
+    }
+}
+
+Plane luma(const QImage &image)
+{
+    Plane p;
+    p.w = image.width();
+    p.h = image.height();
+    p.px.resize(static_cast<size_t>(p.w) * p.h);
+    parallelRows(p.h, [&](int begin, int end) {
+        for (int y = begin; y < end; y++) {
+            const uchar *s = image.constScanLine(y);
+            uint8_t *d = &p.px[static_cast<size_t>(y) * p.w];
+            for (int x = 0; x < p.w; x++) {
+                d[x] = static_cast<uint8_t>((s[4 * x] * 77 + s[4 * x + 1] * 150 + s[4 * x + 2] * 29) >> 8);
+            }
+        }
+    });
+    return p;
+}
+
+Plane half(const Plane &s)
+{
+    Plane p;
+    p.w = s.w / 2;
+    p.h = s.h / 2;
+    p.px.resize(static_cast<size_t>(p.w) * p.h);
+    for (int y = 0; y < p.h; y++) {
+        for (int x = 0; x < p.w; x++) {
+            const int sum = s.at(2 * x, 2 * y) + s.at(2 * x + 1, 2 * y) + s.at(2 * x, 2 * y + 1) + s.at(2 * x + 1, 2 * y + 1);
+            p.px[static_cast<size_t>(y) * p.w + x] = static_cast<uint8_t>((sum + 2) / 4);
+        }
+    }
+    return p;
+}
+
+std::vector<Plane> pyramid(const QImage &image)
+{
+    std::vector<Plane> levels;
+    levels.push_back(luma(image));
+    for (int i = 1; i < kLevels; i++) {
+        levels.push_back(half(levels.back()));
+    }
+    return levels;
+}
+
+// Mean absolute difference over the central part, sampled every step pixels
+double meanDiff(const Plane &a, const Plane &b, int dx, int dy, int step)
+{
+    const int mx = a.w / 8 + std::abs(dx);
+    const int my = a.h / 8 + std::abs(dy);
+    uint64_t sum = 0;
+    uint64_t count = 0;
+    for (int y = my; y < a.h - my; y += step) {
+        for (int x = mx; x < a.w - mx; x += step) {
+            sum += std::abs(a.at(x, y) - b.at(x + dx, y + dy));
+            count++;
+        }
+    }
+    return count ? static_cast<double>(sum) / count : 1e9;
+}
+
+struct Offset {
+    int dx = 0;
+    int dy = 0;
+};
+
+// Shift of frame against the reference: coarse search at 1/16, then +-1 on
+// every finer level down to the full size
+Offset align(const std::vector<Plane> &ref, const std::vector<Plane> &frame)
+{
+    Offset o;
+    for (int l = kLevels - 1; l >= 0; l--) {
+        const int radius = l == kLevels - 1 ? kCoarseRadius : 1;
+        // Fewer samples on the large levels. Every 4th pixel at full size
+        // missed by a pixel on noisy night frames, every 2nd does not.
+        const int step = l <= 1 ? 2 : 1;
+        if (l < kLevels - 1) {
+            o.dx *= 2;
+            o.dy *= 2;
+        }
+        Offset best = o;
+        double bestDiff = 1e18;
+        for (int dy = o.dy - radius; dy <= o.dy + radius; dy++) {
+            for (int dx = o.dx - radius; dx <= o.dx + radius; dx++) {
+                const double d = meanDiff(ref[l], frame[l], dx, dy, step);
+                if (d < bestDiff) {
+                    bestDiff = d;
+                    best = {dx, dy};
+                }
+            }
+        }
+        o = best;
+    }
+    return o;
+}
+
+// Sharpness: gradient energy at 1/2 size
+double sharpness(const Plane &p)
+{
+    uint64_t sum = 0;
+    for (int y = 1; y < p.h; y += 2) {
+        for (int x = 1; x < p.w; x += 2) {
+            const int gx = p.at(x, y) - p.at(x - 1, y);
+            const int gy = p.at(x, y) - p.at(x, y - 1);
+            sum += gx * gx + gy * gy;
+        }
+    }
+    return static_cast<double>(sum);
+}
+
+// Noise of a 1/2 size luma plane: median difference of neighbours
+double noiseSigma(const Plane &p)
+{
+    std::vector<uint8_t> diffs;
+    diffs.reserve(static_cast<size_t>(p.w / 4) * (p.h / 4));
+    for (int y = 0; y < p.h; y += 4) {
+        for (int x = 1; x < p.w; x += 4) {
+            diffs.push_back(static_cast<uint8_t>(std::abs(p.at(x, y) - p.at(x - 1, y))));
+        }
+    }
+    if (diffs.empty()) {
+        return 2.0;
+    }
+    std::nth_element(diffs.begin(), diffs.begin() + diffs.size() / 2, diffs.end());
+    // Median absolute difference of two samples to sigma of one
+    return diffs[diffs.size() / 2] * 1.4826 / std::sqrt(2.0);
+}
+
+} // namespace
+
+QImage NightMerge::merge(const QList<QImage> &input)
+{
+    if (input.isEmpty()) {
+        return {};
+    }
+    if (input.size() == 1) {
+        return input.first();
+    }
+
+    QElapsedTimer timer;
+    timer.start();
+
+    std::vector<QImage> frames;
+    for (const QImage &f : input) {
+        frames.push_back(f.convertToFormat(QImage::Format_RGBX8888));
+    }
+    const int w = frames[0].width();
+    const int h = frames[0].height();
+
+    std::vector<std::vector<Plane>> pyramids;
+    for (const QImage &f : frames) {
+        pyramids.push_back(pyramid(f));
+    }
+
+    // The sharpest frame is the reference (the least shaken one)
+    size_t ref = 0;
+    double bestSharp = -1;
+    for (size_t i = 0; i < frames.size(); i++) {
+        const double s = sharpness(pyramids[i][1]);
+        if (s > bestSharp) {
+            bestSharp = s;
+            ref = i;
+        }
+    }
+
+    std::vector<Offset> offsets(frames.size());
+    for (size_t i = 0; i < frames.size(); i++) {
+        if (i != ref) {
+            offsets[i] = align(pyramids[ref], pyramids[i]);
+        }
+    }
+
+    // Luma differences above the noise mean motion (on 1/2 size planes,
+    // which are less noisy)
+    const Plane &refHalf = pyramids[ref][1];
+    const double sigma = noiseSigma(refHalf);
+    const int threshold = std::clamp(static_cast<int>(std::lround(3.0 * sigma)), 4, 40);
+
+    std::vector<float> acc(static_cast<size_t>(w) * h * 3, 0.0f);
+    std::vector<float> weights(static_cast<size_t>(w) * h, 0.0f);
+
+    for (size_t i = 0; i < frames.size(); i++) {
+        const QImage &f = frames[i];
+        const Plane &fHalf = pyramids[i][1];
+        const Offset o = offsets[i];
+        const bool isRef = i == ref;
+        parallelRows(h, [&](int begin, int end) {
+            for (int y = begin; y < end; y++) {
+                const int sy = y + o.dy;
+                if (sy < 0 || sy >= h) {
+                    continue;
+                }
+                const uchar *s = f.constScanLine(sy);
+                const int ry = std::min(y / 2, refHalf.h - 1);
+                const int fy = std::min(sy / 2, fHalf.h - 1);
+                for (int x = 0; x < w; x++) {
+                    const int sx = x + o.dx;
+                    if (sx < 0 || sx >= w) {
+                        continue;
+                    }
+                    float wt = 1.0f;
+                    if (!isRef) {
+                        const int d = std::abs(refHalf.at(std::min(x / 2, refHalf.w - 1), ry) - fHalf.at(std::min(sx / 2, fHalf.w - 1), fy));
+                        if (d >= 2 * threshold) {
+                            continue;
+                        }
+                        if (d > threshold) {
+                            wt = static_cast<float>(2 * threshold - d) / threshold;
+                        }
+                    }
+                    const size_t idx = static_cast<size_t>(y) * w + x;
+                    acc[3 * idx] += wt * s[4 * sx];
+                    acc[3 * idx + 1] += wt * s[4 * sx + 1];
+                    acc[3 * idx + 2] += wt * s[4 * sx + 2];
+                    weights[idx] += wt;
+                }
+            }
+        });
+    }
+
+    // Mean brightness of the merged frame for the shadow lift
+    double lumaSum = 0;
+    for (size_t idx = 0; idx < weights.size(); idx += 16) {
+        const float wt = weights[idx];
+        lumaSum += (0.299 * acc[3 * idx] + 0.587 * acc[3 * idx + 1] + 0.114 * acc[3 * idx + 2]) / (255.0 * wt);
+    }
+    const double mean = lumaSum / (weights.size() / 16.0);
+    // Gain for the darkest tones: brings the mean up towards 0.42, at most 3x
+    const float gain = static_cast<float>(std::clamp(0.42 / std::max(mean, 0.02), 1.0, 3.0));
+
+    QImage out(w, h, QImage::Format_RGB888);
+    parallelRows(h, [&](int begin, int end) {
+        for (int y = begin; y < end; y++) {
+            uchar *d = out.scanLine(y);
+            for (int x = 0; x < w; x++) {
+                const size_t idx = static_cast<size_t>(y) * w + x;
+                const float wt = weights[idx];
+                for (int c = 0; c < 3; c++) {
+                    float v = acc[3 * idx + c] / (255.0f * wt);
+                    // Slope gain in the shadows, 1 stays 1: highlights keep
+                    v = v * gain / (1.0f + (gain - 1.0f) * v);
+                    d[3 * x + c] = static_cast<uchar>(std::clamp(v * 255.0f + 0.5f, 0.0f, 255.0f));
+                }
+            }
+        }
+    });
+
+    QStringList shifts;
+    for (const Offset &o : offsets) {
+        shifts << QStringLiteral("%1,%2").arg(o.dx).arg(o.dy);
+    }
+    qDebug() << "Night merge:" << frames.size() << "frames" << w << "x" << h << "reference" << ref
+             << "shifts" << shifts.join(QLatin1Char(' ')) << "noise" << sigma << "threshold" << threshold
+             << "mean" << mean << "gain" << gain << "in" << timer.elapsed() << "ms";
+
+    return out;
+}
diff --git a/src/plasmacamera/nightmerge.h b/src/plasmacamera/nightmerge.h
new file mode 100644
index 0000000..64fccb7
--- /dev/null
+++ b/src/plasmacamera/nightmerge.h
@@ -0,0 +1,21 @@
+// SPDX-FileCopyrightText: 2026 morgonf
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <QImage>
+#include <QList>
+
+namespace NightMerge
+{
+/*!
+ * Night mode: merge a burst of frames into one photo with less noise.
+ *
+ * The frames are aligned to the sharpest one (a global shift found on a
+ * luma pyramid, enough for a hand held phone) and averaged. Pixels that
+ * differ from the reference by more than the noise (something moved) get
+ * less weight, so moving objects do not double. The shadows are lifted
+ * afterwards, the noise being lower now.
+ */
+QImage merge(const QList<QImage> &frames);
+}
