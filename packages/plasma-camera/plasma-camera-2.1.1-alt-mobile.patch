+
+#pragma once
+
+#include <QStringList>
+
+/*!
+ * Camera flash through the LED class flash interface in sysfs
+ * (/sys/class/leds/<name>:flash, e.g. the white and yellow LEDs of the
+ * OnePlus 6T). A strobe switches itself off after flash_timeout even if
+ * the application stops, so it is safer than the torch mode.
+ * The flash_* files must be writable (udev rule of ALT Mobile).
+ */
+class Flash
+{
+public:
+    Flash();
+
+    // Whether there is a flash LED whose strobe can be written
+    bool available() const;
+
+    // Strobe all flash LEDs with current (uA per LED) for at most timeout (us)
+    bool fire(int currentMicroamp, int timeoutMicroseconds);
+    void off();
+
+    // Torch mode (brightness 0..max_brightness) of all flash LEDs, as the
+    // autofocus assist light
+    void torch(bool on);
+
+private:
+    QStringList m_leds; // /sys/class/leds/<name>
+};
