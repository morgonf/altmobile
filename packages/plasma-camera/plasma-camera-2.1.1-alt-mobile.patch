+bool Worker::flashWanted() const
+{
+    // Auto: the AGC is at 4x analogue gain or more, the scene is dark
+    constexpr float kFlashAutoGain = 4.0f;
+    return m_cameraHasFlash && (m_flashMode == 2 || (m_flashMode == 1 && m_lastGain >= kFlashAutoGain));
+}
+
+void Worker::startFlashCapture()
+{
+    // In the dark the frames last up to 1/4 s and the queued requests still
+    // ask for that: first wait for short frames, so that AE can follow the
+    // flash within the strobe
+    m_flashPhase = FlashPhase::Prepare;
+    m_flashTimer.start();
+
+    // In the dark continuous AF has nothing to focus on: light the scene
+    // with the torch and search once (autofocus assist)
+    m_flashAfAssist = m_camera->controls().count(&libcamera::controls::AfTrigger) > 0;
+    // Triggered once the frames are short, the search is quicker then
+    m_flashAfTriggerPending = false;
+    m_flashAfTriggered = false;
+    m_flashAfScanning = false;
+    m_flashAfDone = !m_flashAfAssist;
+    if (m_flashAfAssist) {
+        m_flash.torch(true);
+    }
+    // The preparation takes seconds in the dark: show it as progress
+    // (focus, then flash), with the "hold still" hint of the night mode
+    Q_EMIT stillCaptureProgress(0, 2);
+    setMode(CaptureMode::StillImage);
+}
+
+void Worker::handleFlashFrame()
+{
+    // Short frames are there (or it takes too long): strobe
+    constexpr int kShortFrameUs = 35000;
+    constexpr qint64 kPrepareMaxMs = 4000;
+    // Both LEDs (white and yellow on the OnePlus 6T give a neutral light),
+    // 0.75 A each; the strobe lasts at most 1.28 s and goes off by itself
+    constexpr int kFlashCurrentUa = 750000;
+    constexpr int kFlashTimeoutUs = 1280000;
+    // Exposure settled: three frames within 8 %, after AE reacted to the
+    // flash (the first frames still carry the exposure from before), or
+    // after kSettleQuietMs if the flash changes nothing; in any case well
+    // within the strobe
+    constexpr qint64 kSettleMinMs = 300;
+    constexpr qint64 kSettleQuietMs = 650;
+    constexpr qint64 kSettleMaxMs = 1000;
+    constexpr double kSettledRatio = 1.08;
+
+    if (m_flashPhase == FlashPhase::Prepare) {
+        if (m_flashAfAssist && !m_flashAfTriggered && m_frameExposureUs <= kShortFrameUs) {
+            m_flashAfTriggerPending = true;
+            m_flashAfTriggered = true;
+        }
+        // The search shows as Scanning first, then Focused or Failed; frames
+        // queued before the trigger still report the old state
+        if (m_flashAfTriggered && m_frameAfState == libcamera::controls::AfStateScanning) {
+            m_flashAfScanning = true;
+        } else if (m_flashAfScanning) {
+            m_flashAfDone = true;
+        }
+        if ((m_frameExposureUs > kShortFrameUs || !m_flashAfDone) && m_flashTimer.elapsed() < kPrepareMaxMs) {
+            return;
+        }
+        if (m_flashAfAssist) {
+            m_flash.torch(false);
+        }
+        if (!m_flash.fire(kFlashCurrentUa, kFlashTimeoutUs)) {
+            qWarning() << "Flash failed, taking the photo without it";
+            m_flash.torch(false);
+            m_flash.off();
+            m_flashPhase = FlashPhase::None;
+            return; // the plain photo path takes the next frame
+        }
+        Q_EMIT stillCaptureProgress(1, 2);
+        m_flashPhase = FlashPhase::Settle;
+        m_flashExposures.clear();
+        m_flashStartExposure = static_cast<double>(m_frameExposureUs) * m_frameGain;
+        m_flashReacted = false;
+        m_flashTimer.restart();
+        return;
+    }
+
+    const double exposure = static_cast<double>(m_frameExposureUs) * m_frameGain;
+    if (m_flashStartExposure > 0 && std::abs(exposure / m_flashStartExposure - 1.0) > kSettledRatio - 1.0) {
+        m_flashReacted = true;
+    }
+    m_flashExposures.append(exposure);
+    while (m_flashExposures.size() > 3) {
+        m_flashExposures.removeFirst();
+    }
+    const auto [lo, hi] = std::minmax_element(m_flashExposures.begin(), m_flashExposures.end());
+    const bool settled = m_flashExposures.size() == 3 && *lo > 0 && *hi / *lo < kSettledRatio;
+    const qint64 elapsed = m_flashTimer.elapsed();
+    if (!((settled && m_flashReacted && elapsed >= kSettleMinMs) || (settled && elapsed >= kSettleQuietMs)
+          || elapsed >= kSettleMaxMs)) {
+        return;
+    }
+
+    qDebug() << "Flash photo, AF assist" << (m_flashAfDone ? "done" : "timed out") << ", after" << elapsed << "ms, exposure" << m_frameExposureUs << "us gain" << m_frameGain
+             << (settled ? "settled" : "not settled");
+    {
+        const QMutexLocker lock(&m_stillCaptureFramesMutex);
+        m_stillCaptureFrames.enqueue(m_image.copy());
+    }
+    m_flash.off();
+    m_flashPhase = FlashPhase::None;
+    setMode(CaptureMode::ViewFinder);
+    Q_EMIT stillCaptureFrames(m_stillCaptureFrames);
+}
