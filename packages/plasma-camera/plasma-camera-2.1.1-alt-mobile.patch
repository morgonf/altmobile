new file mode 100644
index 0000000..2240ed5
--- /dev/null
+++ b/src/plasmacamera/flash.cpp
@@ -0,0 +1,83 @@
+// SPDX-FileCopyrightText: 2026 morgonf
+// SPDX-License-Identifier: MIT
+
+#include "flash.h"
+
+#include <QDebug>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+
+#include <algorithm>
+
+namespace
+{
+bool writeValue(const QString &path, qint64 value)
+{
+    QFile file(path);
+    if (!file.open(QIODevice::WriteOnly)) {
+        return false;
+    }
+    return file.write(QByteArray::number(value)) > 0;
+}
+
+qint64 readValue(const QString &path)
+{
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly)) {
+        return -1;
+    }
+    return file.readAll().trimmed().toLongLong();
+}
+}
+
+Flash::Flash()
+{
+    const QDir leds(QStringLiteral("/sys/class/leds"));
+    for (const QString &name : leds.entryList(QDir::Dirs | QDir::NoDotAndDotDot)) {
+        const QString dir = leds.filePath(name);
+        if (name.endsWith(QLatin1String(":flash")) && QFileInfo(dir + QStringLiteral("/flash_strobe")).isWritable()) {
+            m_leds << dir;
+        }
+    }
+    qDebug() << "Flash LEDs:" << m_leds;
+}
+
+bool Flash::available() const
+{
+    return !m_leds.isEmpty();
+}
+
+bool Flash::fire(const int currentMicroamp, const int timeoutMicroseconds)
+{
+    bool ok = !m_leds.isEmpty();
+    for (const QString &led : std::as_const(m_leds)) {
+        const qint64 maxCurrent = readValue(led + QStringLiteral("/max_flash_brightness"));
+        const qint64 maxTimeout = readValue(led + QStringLiteral("/max_flash_timeout"));
+        // A strobe left from an earlier photo stays "1" after its timeout
+        writeValue(led + QStringLiteral("/flash_strobe"), 0);
+        ok &= writeValue(led + QStringLiteral("/flash_brightness"),
+                         maxCurrent > 0 ? std::min<qint64>(currentMicroamp, maxCurrent) : currentMicroamp);
+        ok &= writeValue(led + QStringLiteral("/flash_timeout"),
+                         maxTimeout > 0 ? std::min<qint64>(timeoutMicroseconds, maxTimeout) : timeoutMicroseconds);
+    }
+    for (const QString &led : std::as_const(m_leds)) {
+        ok &= writeValue(led + QStringLiteral("/flash_strobe"), 1);
+    }
+    return ok;
+}
+
+void Flash::torch(const bool on)
+{
+    for (const QString &led : std::as_const(m_leds)) {
+        const qint64 maxBrightness = readValue(led + QStringLiteral("/max_brightness"));
+        writeValue(led + QStringLiteral("/brightness"), on ? std::max<qint64>(maxBrightness, 1) : 0);
+    }
+}
+
+void Flash::off()
+{
+    for (const QString &led : std::as_const(m_leds)) {
+        writeValue(led + QStringLiteral("/flash_strobe"), 0);
+    }
+}
