+
+    // Tap to focus (Google Camera style): a tap focuses and meters on the
+    // point, a long press also locks focus and exposure (AE/AF lock).
+    MouseArea {
+        id: focusArea
+
+        readonly property rect frame: viewfinder.contentRect
+
+        x: frame.x
+        y: frame.y
+        width: frame.width
+        height: frame.height
+        enabled: root.camera.available && root.camera.focusRegionAvailable
+
+        function focusAt(mx, my, lock) {
+            root.camera.focusAt(mx / width, my / height, lock);
+            focusRing.show(mx, my, lock);
+        }
+
+        onClicked: (mouse) => {
+            // A tap outside the ring releases a lock
+            if (root.camera.focusLocked && !focusRing.contains(mapToItem(focusRing, mouse.x, mouse.y))) {
+                root.camera.resetFocus();
+            }
+            focusAt(mouse.x, mouse.y, false);
+        }
+        onPressAndHold: (mouse) => focusAt(mouse.x, mouse.y, true)
+    }
+
+    Item {
+        id: focusRing
+
+        readonly property int afState: root.camera.afState
+        property bool locked: false
+
+        width: Kirigami.Units.gridUnit * 4
+        height: width
+        visible: opacity > 0
+        opacity: 0
+
+        function show(mx, my, lock) {
+            x = focusArea.x + mx - width / 2;
+            y = focusArea.y + my - height / 2;
+            locked = lock;
+            exposureSlider.value = root.camera.exposureValue;
+            opacity = 1;
+            hideTimer.restart();
+            revertTimer.stop();
+        }
+
+        Behavior on opacity {
+            NumberAnimation { duration: Kirigami.Units.longDuration }
+        }
+
+        Rectangle {
+            id: circle
+
+            anchors.centerIn: parent
+            width: parent.width
+            height: width
+            radius: width / 2
+            color: "transparent"
+            border.width: 2
+            border.color: focusRing.afState === 2 ? Kirigami.Theme.highlightColor
+                        : focusRing.afState === 3 ? Kirigami.Theme.negativeTextColor
+                        : "white"
+
+            // Pulse while searching
+            SequentialAnimation on scale {
+                running: focusRing.visible && focusRing.afState === 1
+                loops: Animation.Infinite
+                alwaysRunToEnd: true
+                NumberAnimation { from: 1.0; to: 0.85; duration: 350; easing.type: Easing.InOutQuad }
+                NumberAnimation { from: 0.85; to: 1.0; duration: 350; easing.type: Easing.InOutQuad }
+            }
+        }
+
+        Kirigami.Icon {
+            anchors.centerIn: parent
+            width: Kirigami.Units.iconSizes.small
+            height: width
+            visible: focusRing.locked
+            source: "object-locked"
+            color: "white"
+            isMask: true
+        }
+
+        // Exposure compensation next to the ring
+        QQC2.Slider {
+            id: exposureSlider
+
+            anchors.left: parent.right
+            anchors.leftMargin: Kirigami.Units.smallSpacing
+            anchors.verticalCenter: parent.verticalCenter
+            height: Kirigami.Units.gridUnit * 7
+            orientation: Qt.Vertical
+            visible: root.camera.exposureValueAvailable
+            from: -2
+            to: 2
+            stepSize: 0.25
+            onMoved: {
+                root.camera.exposureValue = value;
+                hideTimer.restart();
+            }
+        }
+
+        Kirigami.Icon {
+            anchors.horizontalCenter: exposureSlider.horizontalCenter
+            anchors.bottom: exposureSlider.top
+            width: Kirigami.Units.iconSizes.small
+            height: width
+            visible: exposureSlider.visible
+            source: "brightness-high"
+            color: "white"
+            isMask: true
+        }
+    }
+
+    // Lock label, as in Google Camera
+    QQC2.Label {
+        anchors.horizontalCenter: parent.horizontalCenter
+        y: focusArea.y + Kirigami.Units.gridUnit * 4
+        visible: root.camera.focusLocked
+        text: i18n("Focus and exposure locked")
+        color: "white"
+        padding: Kirigami.Units.smallSpacing
+        background: Rectangle {
+            color: Qt.rgba(0, 0, 0, 0.5)
+            radius: height / 2
+        }
+    }
+
+    // Hide the ring a while after focusing; an unlocked tap region falls back
+    // to continuous focus on the centre
+    Timer {
+        id: hideTimer
+        interval: 5000
+        onTriggered: {
+            if (!focusRing.locked) {
+                focusRing.opacity = 0;
+                revertTimer.restart();
+            }
+        }
+    }
+    Timer {
+        id: revertTimer
+        interval: 3000
+        onTriggered: {
+            if (!root.camera.focusLocked) {
+                root.camera.resetFocus();
+            }
+        }
+    }
+}
