diff --git a/src/plasmacamera.cpp b/src/plasmacamera.cpp
index 2013665..e90e18e 100644
--- a/src/plasmacamera.cpp
+++ b/src/plasmacamera.cpp
@@ -121,6 +121,10 @@ PlasmaCamera::PlasmaCamera(QObject *parent) : QObject(parent)
     connect(m_pipWorker, &Worker::finished, m_pipWorker, &Worker::deleteLater);
     connect(m_pipThread, &QThread::finished, m_pipThread, &QThread::deleteLater);
     connect(m_pipWorker, &Worker::errorOccurred, this, &PlasmaCamera::setError);
+    // Its frames reach the compositor through queued calls, copy them first
+    QMetaObject::invokeMethod(m_pipWorker, [pip = m_pipWorker]() {
+        pip->setDeepCopyFrames(true);
+    }, Qt::QueuedConnection);
     connect(m_pipWorker, &Worker::viewFinderFrame, this, [this](const QImage &frame) {
         if (m_dualMode == 0 || frame.isNull() || m_compositor->pendingSecond >= 1) {
             return;
@@ -929,6 +933,12 @@ void PlasmaCamera::setDualMode(int mode)
         stopPip();
     }
     m_dualMode = mode;
+    // The main camera frames go to the compositor too while dual video runs
+    Worker *main = m_cameraWorker;
+    const bool dual = mode > 0;
+    QMetaObject::invokeMethod(main, [main, dual]() {
+        main->setDeepCopyFrames(dual);
+    }, Qt::QueuedConnection);
     Q_EMIT dualModeChanged();
 }
 
