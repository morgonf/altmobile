+// ALT Mobile: the switch button skips a camera that only repeats another
+// one of the same side. The second rear camera of the OnePlus 6T (IMX376)
+// has about the angle of the main one and no colour calibration; it stays
+// selectable in the settings.
+static bool skippedBySwitch(const std::shared_ptr<libcamera::Camera> &camera)
+{
+    const auto model = camera->properties().get(libcamera::properties::Model);
+    return model && *model == "imx376";
+}
+
 bool PlasmaCamera::switchToNextCamera()
 {
     if (m_state != State::Running) {
@@ -149,10 +159,15 @@
         return false;
     }
 
-    // cyclic increment
-    ++match;
-    if (match == cameras.end()) {
-        match = cameras.begin();
+    // cyclic increment, past the skipped cameras
+    for (size_t i = 0; i < cameras.size(); i++) {
+        ++match;
+        if (match == cameras.end()) {
+            match = cameras.begin();
+        }
+        if (!skippedBySwitch(*match)) {
+            break;
+        }
     }
 
     setCameraDevice( QString::fromStdString((*match)->id()) );
