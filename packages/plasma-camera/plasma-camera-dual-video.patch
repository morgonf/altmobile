+
+int PlasmaCamera::dualMode() const
+{
+    return m_dualMode;
+}
+
+bool PlasmaCamera::dualAvailable() const
+{
+    return partnerCamera() != nullptr;
+}
+
+void PlasmaCamera::setDualMode(int mode)
+{
+    mode = std::clamp(mode, 0, 2);
+    if (mode == m_dualMode) {
+        return;
+    }
+    if (mode > 0 && m_dualMode == 0) {
+        if (m_state != State::Running || !startPip()) {
+            return;
+        }
+    } else if (mode == 0) {
+        stopPip();
+    }
+    m_dualMode = mode;
+    Q_EMIT dualModeChanged();
+}
+
+// The first camera on the other side: the front one for a rear camera, the
+// main rear one (not skipped by the switch button) for the front camera
+std::shared_ptr<libcamera::Camera> PlasmaCamera::partnerCamera() const
+{
+    if (!m_camera || !m_cameraManager) {
+        return nullptr;
+    }
+    const bool front = isFrontCamera(m_camera);
+    for (const auto &camera : m_cameraManager->cameras()) {
+        if (camera != m_camera && isFrontCamera(camera) != front && !skippedBySwitch(camera)) {
+            return camera;
+        }
+    }
+    return nullptr;
+}
+
+// Small streams: the software ISP runs both on the GPU, and the video is
+// recorded from the combined frame. Video alone uses the same width: the
+// encoder (openh264, GstRecorder) keeps up with about 1 MP.
+static constexpr int kVideoWidth = 1280;
+static constexpr int kDualPipWidth = 640;
+static constexpr int kPhotoWidth = 3200;
+
+bool PlasmaCamera::videoMode() const
+{
+    return m_videoMode;
+}
+
+void PlasmaCamera::setVideoMode(const bool videoMode)
+{
+    if (m_videoMode == videoMode) {
+        return;
+    }
+    m_videoMode = videoMode;
+    updateMainStreamWidth();
+    Q_EMIT videoModeChanged();
+}
+
+void PlasmaCamera::updateMainStreamWidth()
+{
+    const int width = (m_videoMode || m_pipCamera) ? kVideoWidth : kPhotoWidth;
+    Worker *main = m_cameraWorker;
+    QMetaObject::invokeMethod(main, [main, width]() {
+        main->setMaxViewfinderWidth(width);
+    }, Qt::QueuedConnection);
+}
+
+bool PlasmaCamera::startPip()
+{
+    const std::shared_ptr<libcamera::Camera> camera = partnerCamera();
+    if (!camera) {
+        return false;
+    }
+    if (camera->acquire() < 0) {
+        setError(QStringLiteral("Failed to acquire the second camera"));
+        return false;
+    }
+    m_pipCamera = camera;
+    m_pipRotationDegrees = softwareRotationFor(camera);
+    m_pipMirror = isFrontCamera(camera);
+    m_pipFrame = QImage();
+    m_dualSwapped = false;
+
+    Settings settings;
+    settings.load(camera->controls());
+    Worker *pip = m_pipWorker;
+    QMetaObject::invokeMethod(pip, [pip, settings, camera]() {
+        pip->setSettings(settings);
+        pip->setMaxViewfinderWidth(kDualPipWidth);
+        pip->setCamera(camera);
+    }, Qt::QueuedConnection);
+    updateMainStreamWidth();
+    return true;
+}
+
+void PlasmaCamera::stopPip()
+{
+    if (!m_pipCamera) {
+        return;
+    }
+    // unsetCamera() stops the stream and releases the camera
+    QMetaObject::invokeMethod(m_pipWorker, "unsetCamera", Qt::BlockingQueuedConnection);
+    m_pipCamera.reset();
+    m_pipFrame = QImage();
+    m_dualSwapped = false;
+    updateMainStreamWidth();
+}
+
+QImage PlasmaCamera::composeDual(const QImage &frame)
+{
+    QImage mainImage = uprightImage(frame, m_softwareRotationDegrees, m_mirrorOutput);
+    const bool swapped = m_dualSwapped && !m_pipFrame.isNull();
+    const QSize size = mainImage.size();
+
+    if (m_dualMode == 2) {
+        // Split: the large picture on top, the other one below
+        QImage canvas(size, QImage::Format_RGB32);
+        QPainter painter(&canvas);
+        painter.setRenderHint(QPainter::SmoothPixmapTransform, true);
+        const QRectF top(0, 0, size.width(), size.height() / 2.0);
+        const QRectF bottom(0, size.height() / 2.0, size.width(), size.height() / 2.0);
+        canvas.fill(Qt::black);
+        drawCover(painter, swapped ? m_pipFrame : mainImage, top);
+        if (!m_pipFrame.isNull()) {
+            drawCover(painter, swapped ? mainImage : m_pipFrame, bottom);
+        }
+        painter.fillRect(QRectF(0, size.height() / 2.0 - 2, size.width(), 4), Qt::white);
+        m_pipRect = QRectF(0, 0.5, 1, 0.5);
+        return canvas;
+    }
+
+    // Picture in picture: the large picture fills the frame, the small one
+    // takes a third of the width in the upper right corner, below the top
+    // bar of the viewfinder
+    QImage small = swapped ? mainImage : m_pipFrame;
+    QImage canvas;
+    if (swapped) {
+        canvas = QImage(size, QImage::Format_RGB32);
+    } else {
+        canvas = std::move(mainImage);
+    }
+    QPainter painter(&canvas);
+    painter.setRenderHint(QPainter::SmoothPixmapTransform, true);
+    if (swapped) {
+        drawCover(painter, m_pipFrame, QRectF(canvas.rect()));
+    }
+    if (!small.isNull()) {
+        const qreal w = size.width() / 3.0;
+        const qreal h = w * small.height() / small.width();
+        const qreal margin = size.width() / 25.0;
+        const QRectF rect(size.width() - margin - w, size.height() * 0.12, w, h);
+        painter.drawImage(rect, small);
+        painter.setPen(QPen(Qt::white, std::max<qreal>(2, size.width() / 300.0)));
+        painter.drawRect(rect);
+        m_pipRect = QRectF(rect.x() / size.width(), rect.y() / size.height(), w / size.width(), h / size.height());
+    }
+    return canvas;
+}
