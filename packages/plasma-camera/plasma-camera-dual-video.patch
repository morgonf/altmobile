diff --git a/src/plasmacamera/gstrecorder.cpp b/src/plasmacamera/gstrecorder.cpp
new file mode 100644
index 0000000..071d8b6
--- /dev/null
+++ b/src/plasmacamera/gstrecorder.cpp
@@ -0,0 +1,260 @@
+// SPDX-FileCopyrightText: 2026 morgonf
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "gstrecorder.h"
+
+#include <QDebug>
+#include <QFile>
+
+#include <gst/app/gstappsrc.h>
+#include <gst/gst.h>
+
+#include <cstring>
+
+// Saving gives up after this long (a muxer that never sees the end of the
+// stream must not keep the app in "saving" forever)
+static constexpr int kStopTimeoutMs = 10000;
+
+GstRecorder::GstRecorder(QObject *parent)
+    : QObject(parent)
+{
+    if (!gst_is_initialized()) {
+        gst_init(nullptr, nullptr);
+    }
+    m_busTimer.setInterval(100);
+    connect(&m_busTimer, &QTimer::timeout, this, &GstRecorder::pollBus);
+}
+
+GstRecorder::~GstRecorder()
+{
+    if (m_pipeline) {
+        gst_element_set_state(m_pipeline, GST_STATE_NULL);
+        gst_object_unref(m_pipeline);
+    }
+}
+
+const char *GstRecorder::gstFormat(const QImage::Format format)
+{
+    // QImage formats are in host byte order for the 32-bit ones (RGB32 is
+    // B, G, R, X in memory on little endian)
+    switch (format) {
+    case QImage::Format_RGB32:
+        return "BGRx";
+    case QImage::Format_ARGB32:
+    case QImage::Format_ARGB32_Premultiplied:
+        return "BGRA";
+    case QImage::Format_RGBX8888:
+        return "RGBx";
+    case QImage::Format_RGBA8888:
+    case QImage::Format_RGBA8888_Premultiplied:
+        return "RGBA";
+    case QImage::Format_RGB888:
+        return "RGB";
+    case QImage::Format_BGR888:
+        return "BGR";
+    default:
+        return "";
+    }
+}
+
+bool GstRecorder::start(const QString &path, const QSize &size, const QImage::Format format, const int bitrate, const bool audio)
+{
+    if (m_pipeline) {
+        return false;
+    }
+    const char *gstFmt = gstFormat(format);
+    if (!*gstFmt || size.isEmpty()) {
+        Q_EMIT errorOccurred(QStringLiteral("Unsupported frame format for recording"));
+        return false;
+    }
+
+    // Colour conversion and encoding run in their own threads (queues): each
+    // alone takes about 15 ms per 1.2 MP frame
+    QString description = QStringLiteral(
+                              "appsrc name=src is-live=true format=time max-buffers=4 leaky-type=upstream "
+                              "caps=video/x-raw,format=%1,width=%2,height=%3,framerate=30/1 "
+                              "! queue max-size-buffers=4 leaky=downstream ! videoconvert n-threads=2 ! video/x-raw,format=I420 "
+                              "! queue max-size-buffers=4 leaky=downstream "
+                              "! openh264enc bitrate=%4 rate-control=bitrate enable-frame-skip=false complexity=low gop-size=60 multi-thread=2 "
+                              "! h264parse ! queue ! mp4mux name=mux fragment-duration=1000 ! filesink name=sink")
+                              .arg(QLatin1String(gstFmt))
+                              .arg(size.width())
+                              .arg(size.height())
+                              .arg(bitrate);
+    if (audio) {
+        description += QStringLiteral(
+            " pulsesrc do-timestamp=true ! audioconvert ! audioresample ! audio/x-raw,rate=48000,channels=2 "
+            "! fdkaacenc bitrate=128000 ! aacparse ! queue ! mux.");
+    }
+
+    GError *error = nullptr;
+    GstElement *pipeline = gst_parse_launch(description.toUtf8().constData(), &error);
+    if (!pipeline || error) {
+        const QString message = error ? QString::fromUtf8(error->message) : QStringLiteral("Could not create the recording pipeline");
+        if (error) {
+            g_error_free(error);
+        }
+        if (pipeline) {
+            gst_object_unref(pipeline);
+        }
+        Q_EMIT errorOccurred(message);
+        return false;
+    }
+
+    // The path is set apart: it may hold spaces and quotes
+    GstElement *sink = gst_bin_get_by_name(GST_BIN(pipeline), "sink");
+    g_object_set(sink, "location", QFile::encodeName(path).constData(), nullptr);
+    gst_object_unref(sink);
+
+    m_pipeline = pipeline;
+    m_source = gst_bin_get_by_name(GST_BIN(pipeline), "src");
+    m_path = path;
+    m_size = size;
+    m_format = format;
+    m_stopping = false;
+    m_lastPts = GST_CLOCK_TIME_NONE;
+
+    if (gst_element_set_state(m_pipeline, GST_STATE_PLAYING) == GST_STATE_CHANGE_FAILURE) {
+        Q_EMIT errorOccurred(QStringLiteral("Could not start the recording pipeline"));
+        teardown(false);
+        return false;
+    }
+    m_busTimer.start();
+    qInfo() << "Recording" << size << gstFmt << bitrate << "bit/s, audio" << audio << "to" << path;
+    return true;
+}
+
+void GstRecorder::push(const QImage &frame)
+{
+    if (!m_source || m_stopping || frame.size() != m_size || frame.format() != m_format) {
+        return;
+    }
+
+    // Timestamped by the running time of the pipeline, the clock of the
+    // sound too. do-timestamp left buffers without one (qtmux: "Buffer has
+    // no PTS") while the pipeline was still starting.
+    GstClock *clock = gst_element_get_clock(m_pipeline);
+    if (!clock) {
+        return;
+    }
+    const GstClockTime now = gst_clock_get_time(clock);
+    gst_object_unref(clock);
+    const GstClockTime base = gst_element_get_base_time(m_pipeline);
+    if (now < base) {
+        return;
+    }
+    // Strictly increasing: frames queued during a stream restart arrive in
+    // a burst, and equal timestamps lost the PTS behind the encoder
+    const GstClockTime pts = now - base;
+    if (GST_CLOCK_TIME_IS_VALID(m_lastPts) && pts < m_lastPts + 5 * GST_MSECOND) {
+        return;
+    }
+    m_lastPts = pts;
+
+    // A copy: viewfinder frames point into camera buffers that are reused
+    const qsizetype line = static_cast<qsizetype>(m_size.width()) * frame.depth() / 8;
+    GstBuffer *buffer = gst_buffer_new_allocate(nullptr, line * m_size.height(), nullptr);
+    GstMapInfo map;
+    if (!gst_buffer_map(buffer, &map, GST_MAP_WRITE)) {
+        gst_buffer_unref(buffer);
+        return;
+    }
+    if (frame.bytesPerLine() == line) {
+        std::memcpy(map.data, frame.constBits(), line * m_size.height());
+    } else {
+        for (int y = 0; y < m_size.height(); y++) {
+            std::memcpy(map.data + line * y, frame.constScanLine(y), line);
+        }
+    }
+    gst_buffer_unmap(buffer, &map);
+    GST_BUFFER_PTS(buffer) = pts;
+
+    // Takes the buffer; dropped when the encoder falls behind (leaky)
+    gst_app_src_push_buffer(GST_APP_SRC(m_source), buffer);
+}
+
+void GstRecorder::stop()
+{
+    if (!m_pipeline || m_stopping) {
+        return;
+    }
+    m_stopping = true;
+    m_stopTimer.start();
+    // To every source: the muxer finishes once video and sound have ended
+    gst_element_send_event(m_pipeline, gst_event_new_eos());
+}
+
+bool GstRecorder::isActive() const
+{
+    return m_pipeline != nullptr;
+}
+
+bool GstRecorder::isStopping() const
+{
+    return m_stopping;
+}
+
+QSize GstRecorder::size() const
+{
+    return m_size;
+}
+
+QImage::Format GstRecorder::format() const
+{
+    return m_format;
+}
+
+void GstRecorder::pollBus()
+{
+    if (!m_pipeline) {
+        m_busTimer.stop();
+        return;
+    }
+
+    GstBus *bus = gst_element_get_bus(m_pipeline);
+    while (GstMessage *message = gst_bus_pop_filtered(bus, static_cast<GstMessageType>(GST_MESSAGE_EOS | GST_MESSAGE_ERROR))) {
+        if (GST_MESSAGE_TYPE(message) == GST_MESSAGE_ERROR) {
+            GError *error = nullptr;
+            gchar *debug = nullptr;
+            gst_message_parse_error(message, &error, &debug);
+            const QString text = QString::fromUtf8(error ? error->message : "unknown");
+            qWarning() << "Recording error:" << text << (debug ? debug : "");
+            g_clear_error(&error);
+            g_free(debug);
+            gst_message_unref(message);
+            gst_object_unref(bus);
+            Q_EMIT errorOccurred(text);
+            teardown(false);
+            return;
+        }
+        // End of stream: the file is complete
+        gst_message_unref(message);
+        gst_object_unref(bus);
+        teardown(true);
+        return;
+    }
+    gst_object_unref(bus);
+
+    if (m_stopping && m_stopTimer.elapsed() > kStopTimeoutMs) {
+        qWarning() << "Recording did not finish in time, the file may be incomplete";
+        teardown(false);
+    }
+}
+
+void GstRecorder::teardown(const bool ok)
+{
+    m_busTimer.stop();
+    if (m_source) {
+        gst_object_unref(m_source);
+        m_source = nullptr;
+    }
+    if (m_pipeline) {
+        gst_element_set_state(m_pipeline, GST_STATE_NULL);
+        gst_object_unref(m_pipeline);
+        m_pipeline = nullptr;
+    }
+    m_stopping = false;
+    const QString path = m_path;
+    m_path.clear();
+    Q_EMIT finished(path, ok);
+}
