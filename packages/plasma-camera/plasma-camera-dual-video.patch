+// Clockwise rotation that makes the frames of a camera upright, from its
+// mounting rotation
+static int softwareRotationFor(const std::shared_ptr<libcamera::Camera> &camera)
+{
+    switch (camera->properties().get(libcamera::properties::Rotation).value_or(0)) {
+    case 90:
+        return 270;
+    case 180:
+        return 180;
+    case 270:
+        return 90;
+    default:
+        return 0;
+    }
+}
+
+static bool isFrontCamera(const std::shared_ptr<libcamera::Camera> &camera)
+{
+    return camera->properties().get(libcamera::properties::Location).value_or(libcamera::properties::CameraLocationExternal)
+        == libcamera::properties::CameraLocationFront;
+}
+
+// Undo a clockwise rotation of the point (u, v), both in 0..1
+static QPointF unrotate(qreal u, qreal v, int degrees)
+{
+    switch (degrees) {
+    case 90:
+        return {v, 1.0 - u};
+    case 180:
+        return {1.0 - u, 1.0 - v};
+    case 270:
+        return {1.0 - v, u};
+    default:
+        return {u, v};
+    }
+}
+
+// A deep copy of the frame as shown: mirrored (front cameras), then turned
+// clockwise. The viewfinder frames point into camera buffers.
+static QImage uprightImage(const QImage &frame, int degrees, bool mirror)
+{
+    QImage image = mirror ? frame.mirrored() : frame.copy();
+    if (degrees != 0) {
+        image = image.transformed(QTransform().rotate(degrees));
+    }
+    if (image.format() != QImage::Format_RGB32 && image.format() != QImage::Format_ARGB32_Premultiplied) {
+        image = image.convertToFormat(QImage::Format_RGB32);
+    }
+    return image;
+}
+
+// Draw the image into the target, cropped to its aspect ratio
+static void drawCover(QPainter &painter, const QImage &image, const QRectF &target)
+{
+    QRectF source(image.rect());
+    const qreal targetAspect = target.width() / target.height();
+    if (source.width() / source.height() > targetAspect) {
+        const qreal w = source.height() * targetAspect;
+        source = QRectF((source.width() - w) / 2, 0, w, source.height());
+    } else {
+        const qreal h = source.width() / targetAspect;
+        source = QRectF(0, (source.height() - h) / 2, source.width(), h);
+    }
+    painter.drawImage(target, image, source);
+}
