+// SPDX-FileCopyrightText: 2026 morgonf
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <QElapsedTimer>
+#include <QImage>
+#include <QObject>
+#include <QTimer>
+
+typedef struct _GstElement GstElement;
+
+/**
+ * ALT Mobile: video recording through GStreamer. QMediaRecorder picks x264
+ * with its default (medium) settings, which the phone cannot encode in real
+ * time, and offers no way to choose a faster setting. The hardware encoder
+ * (Venus) hangs the phone on this kernel. Here the frames go through
+ * openh264 (about twice as fast as x264 ultrafast) into an MP4 with AAC
+ * sound from the microphone.
+ *
+ * The frames are pushed as they come from the camera and are timestamped on
+ * arrival, so the frame rate follows the camera. The MP4 is fragmented: a
+ * recording cut short (the app closed while saving) stays playable.
+ */
+class GstRecorder : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit GstRecorder(QObject *parent = nullptr);
+    ~GstRecorder() override;
+
+    /**
+     * Start a recording of frames of the given size and format (upright,
+     * the recorder does not rotate). bitrate in bits per second.
+     */
+    bool start(const QString &path, const QSize &size, QImage::Format format, int bitrate, bool audio);
+    /** Add a frame; frames of another size or format are skipped */
+    void push(const QImage &frame);
+    /** Finish the file; finished() follows when it is written */
+    void stop();
+
+    bool isActive() const;
+    bool isStopping() const;
+    QSize size() const;
+    QImage::Format format() const;
+
+    /** The GStreamer format for a QImage format, empty if there is none */
+    static const char *gstFormat(QImage::Format format);
+
+Q_SIGNALS:
+    void finished(const QString &path, bool ok);
+    void errorOccurred(const QString &message);
+
+private:
+    void pollBus();
+    void teardown(bool ok);
+
+    GstElement *m_pipeline = nullptr;
+    GstElement *m_source = nullptr;
+    QTimer m_busTimer;
+    QElapsedTimer m_stopTimer;
+    QString m_path;
+    QSize m_size;
+    QImage::Format m_format = QImage::Format_Invalid;
+    bool m_stopping = false;
+    quint64 m_lastPts = ~quint64(0); // GST_CLOCK_TIME_NONE
+};
