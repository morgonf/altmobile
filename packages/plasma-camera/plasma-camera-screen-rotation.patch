+void PlasmaCameraManager::updateFromScreenOrientation()
+{
+    QScreen *screen = QGuiApplication::primaryScreen();
+    if (!screen || screen->orientation() == Qt::PrimaryOrientation) {
+        return;
+    }
+    // The panel of a phone is portrait
+    const int degrees = screen->angleBetween(Qt::PortraitOrientation, screen->orientation());
+    qInfo() << "Screen orientation:" << screen->orientation() << degrees;
+    m_screenRotationDegrees = degrees;
+    if (m_plasmaCamera) {
+        m_plasmaCamera->setScreenRotationDegrees(degrees);
+    }
+}
+
 float PlasmaCameraManager::outputOrientationDegrees() const
 {
     return m_plasmaCamera->softwareRotationDegrees() + m_orientationSensorDegrees;
