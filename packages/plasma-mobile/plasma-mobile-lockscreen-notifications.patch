+
+MobileShellSettings::LockscreenNotifications MobileShellSettings::lockscreenNotifications() const
+{
+    auto group = KConfigGroup{m_config, LOCKSCREEN_CONFIG_GROUP};
+    return (LockscreenNotifications)group.readEntry("lockscreenNotifications", (int)LockscreenNotifications::ShowNotifications);
+}
+
+void MobileShellSettings::setLockscreenNotifications(const LockscreenNotifications value)
+{
+    auto group = KConfigGroup{m_config, LOCKSCREEN_CONFIG_GROUP};
+    group.writeEntry("lockscreenNotifications", (int)value, KConfigGroup::Notify);
+    m_config->sync();
+}
