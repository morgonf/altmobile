diff --git a/kcms/info/devicename.cpp b/kcms/info/devicename.cpp
new file mode 100644
index 0000000..070fb58
--- /dev/null
+++ b/kcms/info/devicename.cpp
@@ -0,0 +1,165 @@
+/*
+    SPDX-FileCopyrightText: 2026 morgonf <morgonf@altlinux.org>
+
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#include "devicename.h"
+
+#include <QDBusConnection>
+#include <QDBusInterface>
+#include <QDBusMessage>
+#include <QDBusPendingCallWatcher>
+#include <QDBusPendingReply>
+#include <QDBusVariant>
+#include <QFile>
+#include <QHash>
+
+#include <KLocalizedString>
+
+namespace
+{
+const QString kService = QStringLiteral("org.freedesktop.hostname1");
+const QString kPath = QStringLiteral("/org/freedesktop/hostname1");
+const QString kInterface = QStringLiteral("org.freedesktop.hostname1");
+
+// Russian letters for the network name (GOST 7.79 B without diacritics)
+const QHash<QChar, QString> &translit()
+{
+    static const QHash<QChar, QString> table = {
+        {u'а', QStringLiteral("a")},  {u'б', QStringLiteral("b")},   {u'в', QStringLiteral("v")},  {u'г', QStringLiteral("g")},
+        {u'д', QStringLiteral("d")},  {u'е', QStringLiteral("e")},   {u'ё', QStringLiteral("yo")}, {u'ж', QStringLiteral("zh")},
+        {u'з', QStringLiteral("z")},  {u'и', QStringLiteral("i")},   {u'й', QStringLiteral("j")},  {u'к', QStringLiteral("k")},
+        {u'л', QStringLiteral("l")},  {u'м', QStringLiteral("m")},   {u'н', QStringLiteral("n")},  {u'о', QStringLiteral("o")},
+        {u'п', QStringLiteral("p")},  {u'р', QStringLiteral("r")},   {u'с', QStringLiteral("s")},  {u'т', QStringLiteral("t")},
+        {u'у', QStringLiteral("u")},  {u'ф', QStringLiteral("f")},   {u'х', QStringLiteral("x")},  {u'ц', QStringLiteral("cz")},
+        {u'ч', QStringLiteral("ch")}, {u'ш', QStringLiteral("sh")},  {u'щ', QStringLiteral("shh")}, {u'ъ', QString()},
+        {u'ы', QStringLiteral("y")},  {u'ь', QString()},             {u'э', QStringLiteral("e")},  {u'ю', QStringLiteral("yu")},
+        {u'я', QStringLiteral("ya")},
+    };
+    return table;
+}
+}
+
+DeviceName::DeviceName(QObject *parent)
+    : QObject(parent)
+{
+    // The device tree names the phone ("OnePlus 6T"), with a trailing NUL
+    QFile f(QStringLiteral("/sys/firmware/devicetree/base/model"));
+    if (f.open(QIODevice::ReadOnly)) {
+        m_model = QString::fromUtf8(f.readAll()).remove(QChar(0)).trimmed();
+    }
+    load();
+}
+
+void DeviceName::load()
+{
+    QDBusInterface hostnamed(kService, kPath, kInterface, QDBusConnection::systemBus());
+    const QString pretty = hostnamed.property("PrettyHostname").toString();
+    m_hostname = hostnamed.property("Hostname").toString();
+    m_name = pretty.isEmpty() ? hostnamed.property("StaticHostname").toString() : pretty;
+    // Nothing set yet: the kernel hostname ("localhost")
+    if (m_name.isEmpty()) {
+        m_name = m_hostname;
+    }
+    Q_EMIT nameChanged();
+}
+
+QString DeviceName::name() const
+{
+    return m_name;
+}
+
+QString DeviceName::hostname() const
+{
+    return m_hostname;
+}
+
+QString DeviceName::model() const
+{
+    return m_model;
+}
+
+QString DeviceName::error() const
+{
+    return m_error;
+}
+
+QString DeviceName::hostnameFor(const QString &name) const
+{
+    QString out;
+    for (const QChar c : name.toLower()) {
+        if ((c >= u'a' && c <= u'z') || (c >= u'0' && c <= u'9')) {
+            out += c;
+        } else if (translit().contains(c)) {
+            out += translit().value(c);
+        } else if (!out.endsWith(u'-')) {
+            out += u'-';
+        }
+    }
+    // A hostname label: at most 63 characters, no hyphen at either end
+    out = out.left(63);
+    while (out.startsWith(u'-')) {
+        out.remove(0, 1);
+    }
+    while (out.endsWith(u'-')) {
+        out.chop(1);
+    }
+    return out.isEmpty() ? QStringLiteral("phone") : out;
+}
+
+// BlueZ keeps the adapter alias it was given once (localhost.localdomain)
+// and does not follow the hostname: set it on every adapter
+void DeviceName::setBluetoothAlias(const QString &name)
+{
+    for (int i = 0; i < 4; i++) {
+        QDBusMessage msg = QDBusMessage::createMethodCall(QStringLiteral("org.bluez"),
+                                                          QStringLiteral("/org/bluez/hci%1").arg(i),
+                                                          QStringLiteral("org.freedesktop.DBus.Properties"),
+                                                          QStringLiteral("Set"));
+        msg << QStringLiteral("org.bluez.Adapter1") << QStringLiteral("Alias") << QVariant::fromValue(QDBusVariant(name));
+        // No adapter or Bluetooth stopped: nothing to rename
+        QDBusConnection::systemBus().asyncCall(msg);
+    }
+}
+
+void DeviceName::setName(const QString &name)
+{
+    const QString pretty = name.simplified();
+    if (pretty.isEmpty()) {
+        return;
+    }
+    m_error.clear();
+    Q_EMIT errorChanged();
+
+    // Pretty name first, then the network name; interactive for polkit
+    auto call = [](const QString &method, const QString &value) {
+        QDBusMessage msg = QDBusMessage::createMethodCall(kService, kPath, kInterface, method);
+        msg << value << true;
+        // hostnamed asks polkit interactively only with this flag set
+        msg.setInteractiveAuthorizationAllowed(true);
+        return QDBusConnection::systemBus().asyncCall(msg);
+    };
+    auto *watcher = new QDBusPendingCallWatcher(call(QStringLiteral("SetPrettyHostname"), pretty), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this, watcher, pretty, call]() {
+        watcher->deleteLater();
+        QDBusPendingReply<> reply = *watcher;
+        if (reply.isError()) {
+            m_error = i18nd("kcm_mobile_info", "Could not rename the device: %1", reply.error().message());
+            Q_EMIT errorChanged();
+            load();
+            return;
+        }
+        auto *second = new QDBusPendingCallWatcher(call(QStringLiteral("SetStaticHostname"), hostnameFor(pretty)), this);
+        connect(second, &QDBusPendingCallWatcher::finished, this, [this, second]() {
+            second->deleteLater();
+            QDBusPendingReply<> reply = *second;
+            if (reply.isError()) {
+                m_error = i18nd("kcm_mobile_info", "Could not set the network name: %1", reply.error().message());
+                Q_EMIT errorChanged();
+            }
+            load();
+            setBluetoothAlias(m_name);
+        });
+    });
+}
diff --git a/kcms/info/devicename.h b/kcms/info/devicename.h
new file mode 100644
index 0000000..83212b4
--- /dev/null
+++ b/kcms/info/devicename.h
@@ -0,0 +1,50 @@
+/*
+    SPDX-FileCopyrightText: 2026 morgonf <morgonf@altlinux.org>
+
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#include <QObject>
+
+#ifndef DEVICENAME_H
+#define DEVICENAME_H
+
+// ALT Mobile: device name and model. The name is the pretty hostname of
+// systemd-hostnamed (shown to Bluetooth devices), the static hostname
+// (network) is derived from it in Latin letters.
+class DeviceName : public QObject
+{
+    Q_OBJECT
+
+    Q_PROPERTY(QString name READ name NOTIFY nameChanged)
+    Q_PROPERTY(QString hostname READ hostname NOTIFY nameChanged)
+    Q_PROPERTY(QString model READ model CONSTANT)
+    Q_PROPERTY(QString error READ error NOTIFY errorChanged)
+
+public:
+    DeviceName(QObject *parent = nullptr);
+
+    QString name() const;
+    QString hostname() const;
+    QString model() const;
+    QString error() const;
+
+    // Network name for a device name: Latin letters, digits and hyphens
+    Q_INVOKABLE QString hostnameFor(const QString &name) const;
+    Q_INVOKABLE void setName(const QString &name);
+
+Q_SIGNALS:
+    void nameChanged();
+    void errorChanged();
+
+private:
+    void load();
+    void setBluetoothAlias(const QString &name);
+
+    QString m_name;
+    QString m_hostname;
+    QString m_model;
+    QString m_error;
+};
+
+#endif // DEVICENAME_H
