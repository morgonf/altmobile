diff -ruN -x .git a/quicksettings/screenrotation/screenrotationutil.cpp b/quicksettings/screenrotation/screenrotationutil.cpp
--- a/quicksettings/screenrotation/screenrotationutil.cpp	2026-09-12 04:24:49.000000000 -0400
+++ b/quicksettings/screenrotation/screenrotationutil.cpp	2026-10-04 16:58:21.741461721 -0400
@@ -22,6 +22,27 @@
 {
     connect(m_sensor, &QOrientationSensor::activeChanged, this, &ScreenRotationUtil::availableChanged);
 
+    // ALT Mobile: the orientation sensor may come up after the shell (the
+    // session no longer waits for iio-sensor-proxy). Retry the backend for
+    // a while, otherwise the quick setting stays hidden for the session.
+    m_available = m_sensor->connectToBackend();
+    if (!m_available) {
+        auto *retry = new QTimer(this);
+        retry->setInterval(2000);
+        connect(retry, &QTimer::timeout, this, [this, retry]() {
+            if (m_sensor->connectToBackend()) {
+                m_available = true;
+                retry->stop();
+                retry->deleteLater();
+                Q_EMIT availableChanged();
+            } else if (++m_availableRetries >= 60) {
+                retry->stop();
+                retry->deleteLater();
+            }
+        });
+        retry->start();
+    }
+
     connect(KScreen::ConfigMonitor::instance(), &KScreen::ConfigMonitor::configurationChanged, this, [this]() {
         Q_EMIT autoScreenRotationEnabledChanged();
     });
@@ -78,7 +99,7 @@
 
 bool ScreenRotationUtil::isAvailable()
 {
-    return m_sensor->connectToBackend();
+    return m_available;
 }
 
 void ScreenRotationUtil::actuallySetAutoScreenRotationEnabled(bool value)
