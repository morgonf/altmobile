diff -ruN -x .git a/kcms/mobileshell/plasma-mobile-open-quicksettings b/kcms/mobileshell/plasma-mobile-open-quicksettings
--- a/kcms/mobileshell/plasma-mobile-open-quicksettings	1969-12-31 19:00:00.000000000 -0500
+++ b/kcms/mobileshell/plasma-mobile-open-quicksettings	2026-10-04 18:29:30.524703071 -0400
@@ -0,0 +1,5 @@
+#!/bin/sh
+# ALT Mobile: the "Edit" button of the quick settings drawer. The marker
+# makes kcm_mobileshell open its quick settings page.
+touch "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/alt-mobile-open-quicksettings"
+exec plasma-open-settings kcm_mobileshell
