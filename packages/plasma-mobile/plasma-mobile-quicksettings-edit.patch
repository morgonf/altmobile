+    Q_PROPERTY(bool openQuickSettings READ openQuickSettings CONSTANT)
 
 public:
     KCMMobileShell(QObject *parent, const KPluginMetaData &data)
         : KQuickManagedConfigModule(parent, data)
     {
         setButtons({});
