@@ -9,15 +9,33 @@
 #include <KQuickManagedConfigModule>
 #include <KSharedConfig>
 
+#include <QFile>
+#include <QStandardPaths>
+
 class KCMMobileShell : public KQuickManagedConfigModule
 {
     Q_OBJECT
+    // ALT Mobile: the "Edit" button of the quick settings drawer leaves a
+    // marker in the runtime directory, the module then opens the quick
+    // settings page directly (plasma-settings has no way to pass arguments)
+    Q_PROPERTY(bool openQuickSettings READ openQuickSettings CONSTANT)
 
 public:
     KCMMobileShell(QObject *parent, const KPluginMetaData &data)
         : KQuickManagedConfigModule(parent, data)
     {
         setButtons({});
+
+        const QString marker = QStandardPaths::writableLocation(QStandardPaths::RuntimeLocation) + QStringLiteral("/alt-mobile-open-quicksettings");
+        m_openQuickSettings = QFile::exists(marker);
+        if (m_openQuickSettings) {
+            QFile::remove(marker);
+        }
+    }
+
+    bool openQuickSettings() const
+    {
+        return m_openQuickSettings;
     }
 
 Q_SIGNALS:
@@ -25,6 +43,7 @@
 
 private:
     KSharedConfig::Ptr m_config;
+    bool m_openQuickSettings = false;
 };
 
