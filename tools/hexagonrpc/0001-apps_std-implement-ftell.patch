diff --git a/hexagonrpcd/hexagonfs.c b/hexagonrpcd/hexagonfs.c
index bd9f353..a68c4a9 100644
--- a/hexagonrpcd/hexagonfs.c
+++ b/hexagonrpcd/hexagonfs.c
@@ -227,6 +227,23 @@ int hexagonfs_lseek(struct hexagonfs_fd **fds, int fileno, off_t off, int whence
 	return fd->ops->seek(fd, off, whence);
 }
 
+off_t hexagonfs_tell(struct hexagonfs_fd **fds, int fileno)
+{
+	struct hexagonfs_fd *fd;
+
+	if (fileno < 0 || fileno >= HEXAGONFS_MAX_FD)
+		return -EBADF;
+
+	fd = fds[fileno];
+	if (fd == NULL)
+		return -EBADF;
+
+	if (fd->ops->tell == NULL)
+		return -ENOSYS;
+
+	return fd->ops->tell(fd);
+}
+
 ssize_t hexagonfs_read(struct hexagonfs_fd **fds, int fileno, size_t size, void *ptr)
 {
 	struct hexagonfs_fd *fd;
