[Icon Theme]
Name=ALT
Name[ru]=ALT
Comment=Breeze with ALT Mobile start-here icon
Comment[ru]=Breeze со знаком «Альт Мобильный» вместо значка KDE
Inherits=breeze,hicolor
DisplayDepth=32
Example=folder
# Без этого Plasma не перекрашивает символьные значки под цветовую схему,
# и в строке состояния и панели навигации они остаются графитовыми
FollowsColorScheme=true
DesktopDefault=48
DesktopSizes=16,22,32,48,64,128,256
ToolbarDefault=22
ToolbarSizes=16,22,32,48
MainToolbarDefault=22
MainToolbarSizes=16,22,32,48
SmallDefault=22
SmallSizes=16,22,32,48
PanelDefault=48
Directories=places/scalable

[places/scalable]
Size=22
MinSize=8
MaxSize=512
Context=Places
Type=Scalable
