msgid "Navigation"
msgstr "Навигация"

msgctxt "@label"
msgid "Navigation Mode"
msgstr "Способ навигации"

msgctxt "Nav Panel Navigation Mode"
msgid "Panel"
msgstr "Панель"

msgctxt "Gestures Navigation Mode"
msgid "Gestures"
msgstr "Жесты"

msgid "Always show keyboard toggle"
msgstr "Всегда показывать кнопку клавиатуры"

msgid "Whether to always show the keyboard toggle button on the navigation panel."
msgstr "Показывать на панели навигации кнопку вызова экранной клавиатуры всегда."

msgid "Show gesture handle"
msgstr "Показывать полоску для жестов"

msgid "Whether to add a panel on the bottom with a gesture handle."
msgstr "Добавить внизу экрана панель с полоской для жестов."

msgid "Swipe up and release to go to Home Screen"
msgstr "Проведите вверх и отпустите, чтобы перейти на домашний экран"

msgid "Swipe up, hold then release to enter Task Switcher"
msgstr "Проведите вверх, задержите палец и отпустите, чтобы открыть переключатель задач"

msgid "Swipe left and right near the bottom screen edge to scrub through open tasks. Release to select a task to focus"
msgstr "Проведите влево или вправо у нижнего края экрана, чтобы перебрать открытые задачи. Отпустите палец, чтобы выбрать задачу"
