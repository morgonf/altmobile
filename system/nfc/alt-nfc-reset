#!/bin/sh
# Восстановление NFC (NXP PN553) после сбоя, от root. Вызывает служба
# пользователя alt-nfc через alt-nfc-reset.service (разрешено polkit).
#
# Только перезапуск neard. После неудачного подключения к двойной карте
# (ISO-DEP и MIFARE Classic) neard держит объект карты и отвечает «занято»
# на StartPollLoop, хотя контроллер жив. Перепривязку драйвера здесь не
# делаем: если контроллер завис по-настоящему (I2C -121), отвязка
# nxp-nci_i2c попадает во взаимную блокировку info_lock в ядре, процессы
# повисают в состоянии D и не дают даже выключить телефон. Такой сбой
# лечит только перезагрузка.
logger -t alt-nfc-reset "перезапуск neard"
systemctl restart neard
