# Загрузочные образы, большие и легко пересобираемые
images/
*.img

# Заводская калибровка с устройства: проприетарные данные производителя,
# лежат на телефоне, разбираются tools/acdb.py, в репозиторий не кладём
acdb/
*.acdb

# Артефакты сборки модулей
*.ko
*.o
*.mod
*.mod.c
*.symvers
.*.cmd
modules.order
__pycache__/
*.pyc

# Динамические модули ADSP и настройки звука с разделов dsp_a и vendor_a:
# проприетарные файлы Qualcomm и OnePlus, на телефоне они уже есть
dsp/
vendor/

# Черновая копия исходников модулей, итоговые лежат в kernel/src
kernel/work/
scripts/export-private.sed
